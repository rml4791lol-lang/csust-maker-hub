# 服务器本地配置示例：复制为 .env.admin（不要提交仓库）
# 超级管理员 = 技术部部长（你本人），首次启动自动创建/更新
SUPER_ADMIN_EMAIL=你的邮箱@example.com
SUPER_ADMIN_PASSWORD=你的密码（至少8位含字母数字）
SUPER_ADMIN_NAME=你的真实姓名
SUPER_ADMIN_PHONE=你的手机号
# 可选：身份默认是 技术部 / dept_lead（技术部部长），需要改再填
# SUPER_ADMIN_DEPT=技术部
# SUPER_ADMIN_IDENTITY=dept_lead

# 内容后台（Basic Auth）账号
ADMIN_USERS=admin:改掉这个默认密码
# agent token（可选）
AGENT_TOKENS=token:名字
# 部署目标（可选）
DEPLOY_TARGET=/var/www/csust-maker/
