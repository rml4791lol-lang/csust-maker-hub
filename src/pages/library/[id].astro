---
import Base from '../../layouts/Base.astro';
import { items, typeMeta } from '../../data/items';
import { members } from '../../data/members';
import { publishedItems, isExpired } from '../../data/validate';
import { site } from '../../data/site';
import { viewCount } from '../../data/metrics';

export async function getStaticPaths() {
  // 外部项目没有详情页，列表直接跳转原文
  return publishedItems(items)
    .filter((item) => item.type !== 'link')
    .map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const meta = typeMeta[item.type];
const involved = members.filter((m) => item.people.includes(m.name));
// 同类推荐只取已发布内容，避免把草稿标题带到公开详情页
const related = publishedItems(items)
  .filter((i) => i.id !== item.id && i.type === item.type)
  .slice(0, 3);

const rows: { k: string; v: string }[] = [
  { k: '类型', v: meta.label },
  { k: '日期', v: item.date.replaceAll('-', '.') },
  { k: '状态', v: item.status },
];
if (item.extra?.deliverable) rows.push({ k: '交付形态', v: item.extra.deliverable });
if (item.extra?.level) rows.push({ k: '赛级', v: item.extra.level });
if (item.extra?.award) rows.push({ k: '成绩', v: item.extra.award });
if (item.extra?.team) rows.push({ k: '队伍', v: item.extra.team });
if (item.extra?.place) rows.push({ k: '地点', v: item.extra.place });
if (item.extra?.difficulty) rows.push({ k: '难度', v: item.extra.difficulty });
if (item.extra?.duration) rows.push({ k: '时长', v: item.extra.duration });
rows.push({ k: '参与人', v: item.people.join('、') });
if (item.author) rows.push({ k: '作者', v: item.author });
const REVIEW_METHOD_LABEL: Record<string, string> = { agent: 'agent 初审', human: '人工终审', both: '双审' };
const reviewText = item.reviewer
  ? [item.reviewer, item.reviewedAt ?? '', item.reviewMethod ? REVIEW_METHOD_LABEL[item.reviewMethod] ?? item.reviewMethod : '']
      .filter(Boolean)
      .join(' · ')
  : item.publishState === 'published'
    ? '已发布'
    : '待审核';
rows.push({ k: '审核', v: reviewText });
rows.push({ k: '更新', v: item.date.replaceAll('-', '.') });
rows.push({ k: '浏览', v: String(viewCount(item.id)) });
---

{item.expiresAt && isExpired(item) && (
  <div class="wrap">
    <div class="expired-banner">
      <b>已截止</b>
      <span>有效期到 {item.expiresAt}，内容仅供参考。</span>
    </div>
  </div>
)}

<Base title={item.title} description={item.summary}>
  <div class="wrap page-header">
    <a href="/library" class="crumb" style="display:block;width:fit-content;margin-bottom:14px;">← 返回内容库</a>
    <span class="type-tag" data-type={item.type} style="position:static;display:inline-flex;margin-bottom:16px;"><i>{meta.glyph}</i>{meta.label}</span>
    <h1>{item.title}</h1>
    <p>{item.summary}</p>
  </div>

  <div class="wrap detail-grid" style="padding-bottom:96px;">
    <article class="detail-main">
      {item.type === 'guide' && (
        <>
          {item.extra?.scene && (
            <section>
              <h2>问题场景</h2>
              <p>{item.extra.scene}</p>
            </section>
          )}
          {item.extra?.path && (
            <section>
              <h2>现成路径</h2>
              <ol class="outline">
                {item.extra.path.map((step, i) => (
                  <li><span class="n">0{i + 1}</span><span>{step}</span></li>
                ))}
              </ol>
            </section>
          )}
          {item.extra?.prompt && (
            <section>
              <h2>可复制提示词</h2>
              <div class="code-block">
                <pre>{item.extra.prompt}</pre>
                <button class="copy-btn" data-copy-text={item.extra.prompt}>复制</button>
              </div>
            </section>
          )}
          {item.extra?.pitfalls && (
            <section>
              <h2>常见错误</h2>
              <ul class="pitfalls">
                {item.extra.pitfalls.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </section>
          )}
          {item.extra?.usage && (
            <section>
              <h2>我们自己的使用记录</h2>
              <p>{item.extra.usage}</p>
            </section>
          )}
          {item.extra?.sourceUrl && (
            <p class="source-line">
              收录自
              <a href={item.extra.sourceUrl} target="_blank" rel="noopener noreferrer">
                {item.extra.sourceName ?? '原文'}
              </a>
            </p>
          )}
        </>
      )}

      {item.type === 'skill' && (
        <section>
          <h2>指令</h2>
          <div class="code-block">
            <pre>{item.extra?.command ?? ''}</pre>
            <button class="copy-btn" data-copy-text={item.extra?.command ?? ''}>复制</button>
          </div>
          {item.extra?.appliesTo && <p class="code-meta">适用：{item.extra.appliesTo}</p>}
        </section>
      )}

      {item.type === 'template' && item.extra?.downloadUrl && (
        <section>
          <h2>下载</h2>
          <p>{item.summary}</p>
          <a class="btn btn-primary" href={item.extra.downloadUrl} download>下载文件</a>
        </section>
      )}

      {item.type === 'training' && (
        <section>
          <h2>{item.extra?.kind === 'archive' ? '培训档案' : '培训信息'}</h2>
          <ul class="kv-list">
            {item.extra?.deadline && <li><span>报名截止</span><b>{item.extra.deadline}</b></li>}
            {item.extra?.materials && <li><span>地点 / 材料</span><b>{item.extra.materials}</b></li>}
          </ul>
        </section>
      )}

      {item.type === 'video' && (
        <section>
          <h2>视频</h2>
          {item.extra?.embedUrl ? (
            <div class="video-frame">
              <iframe
                src={item.extra.embedUrl}
                title={item.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          ) : (
            <div class="video-placeholder">
              <span class="vp-icon">▶</span>
              <b>视频待上传</b>
              <p>把播放器地址填到 <code>content/items.json</code> 里这条记录的 <code>embedUrl</code>，这里就会直接播放。</p>
            </div>
          )}
          {item.extra?.duration && <div class="video-meta">时长 {item.extra.duration}</div>}
        </section>
      )}

      {item.extra?.outline && (
        <section>
          <h2>课程大纲</h2>
          <ol class="outline">
            {item.extra.outline.map((o, i) => (
              <li><span class="n">0{i + 1}</span><span>{o}</span></li>
            ))}
          </ol>
        </section>
      )}

      {item.extra?.recap && (
        <section>
          <h2>复盘</h2>
          <p>{item.extra.recap}</p>
        </section>
      )}

      {item.people.length > 0 && (
        <section>
          <h2>参与人</h2>
          <div class="people" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr));">
            {involved.map((m) => (
              <div class="person">
                <div class="avatar">{m.name.slice(0, 1)}</div>
                <h4>{m.name}{m.role ? ` · ${m.role}` : ''}</h4>
                <div class="dept">{m.dept} / {m.grade}</div>
                <div class="skills">{m.skills.slice(0, 2).map((s) => <span class="tag">{s}</span>)}</div>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="feedback" data-item={item.id} data-endpoint={site.feedbackEndpoint} data-track={site.trackEndpoint}>
        <h2>这篇有用吗</h2>
        <div class="fb-actions">
          <button class="fb-btn" data-vote="useful">有用</button>
          <button class="fb-btn" data-vote="useless">没用</button>
          <button class="fb-btn" data-vote="confirmed">照做出来了</button>
        </div>
        <input class="fb-note" type="text" placeholder="想说的话（可选）" />
        <p class="fb-msg" aria-live="polite"></p>
      </section>

      {related.length > 0 && (
        <section>
          <h2>同类条目</h2>
          <div class="tags" style="gap:8px;">
            {related.map((r) => (
              <a href={`/library/${r.id}`} class="chip">{r.title}</a>
            ))}
          </div>
        </section>
      )}
    </article>

    <aside class="detail-side">
      <div class="side-box">
        <h3>条目信息</h5>
        <dl class="meta-list">
          {rows.map((r) => (
            <div><dt>{r.k}</dt><dd>{r.v}</dd></div>
          ))}
        </dl>
      </div>

      <div class="side-box">
        <h3>标签</h5>
        <div class="tags">{item.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </div>

    </aside>
  </div>
</Base>

<script>
  // 反馈：有用 / 没用 / 照做出来了（issue #11）；文案单一来源在 src/data/vote-labels.ts
  import { voteLabel as voteLabels } from '../../data/vote-labels';
  document.querySelectorAll<HTMLElement>('.feedback').forEach((box) => {
    const itemId = box.dataset.item || '';
    const key = `fb:${itemId}`;
    const msg = box.querySelector<HTMLElement>('.fb-msg');
    const note = box.querySelector<HTMLInputElement>('.fb-note');
    const endpoint = box.dataset.endpoint || '';
    const trackUrl = box.dataset.track || '';
    const btns = box.querySelectorAll<HTMLButtonElement>('.fb-btn');

    // 浏览打点：sendBeacon 失败静默（本地开发没有后台时）
    if (trackUrl && itemId) {
      try {
        navigator.sendBeacon(trackUrl, JSON.stringify({ id: itemId }));
      } catch {
        /* 忽略 */
      }
    }

    const saved = localStorage.getItem(key);
    if (saved && voteLabels[saved] && msg) msg.textContent = `你之前标记过：${voteLabels[saved]}`;

    btns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const vote = btn.dataset.vote || '';
        const payload = { item: itemId, vote, note: note?.value || '', at: new Date().toISOString() };
        localStorage.setItem(key, vote);
        btns.forEach((b) => b.classList.toggle('active', b === btn));
        if (msg) msg.textContent = '已记录，谢谢';

        if (endpoint) {
          try {
            await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          } catch {
            if (msg) msg.textContent = '已记录在本地（线上提交失败）';
          }
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copyText || '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = '已复制';
      } catch {
        btn.textContent = '复制失败';
      }
      setTimeout(() => {
        btn.textContent = '复制';
      }, 1500);
    });
  });
</script>
