---
import Base from '../../layouts/Base.astro';
import { items, typeMeta as meta, sortedByDate } from '../../data/items';

const types = ['project', 'competition', 'activity', 'course'] as const;
const counts = Object.fromEntries(
  types.map((t) => [t, items.filter((i) => i.type === t).length])
) as Record<(typeof types)[number], number>;
---

<Base title="内容库" description="项目、竞赛、活动、课程，每个条目都带参与人、状态和可复用的产出。">
  <div class="wrap page-header">
    <span class="crumb">LIBRARY / 内容库</span>
    <h1>做过的东西</h1>
    <p>项目、竞赛、活动、课程。不是文章列表——每条都有参与人、当前状态和能拿走用的产出。</p>
  </div>

  <div class="wrap" style="padding-bottom:96px;">
    <div class="filter-bar" id="filters">
      <button class="chip active" data-filter="all">全部 <span class="count">{items.length}</span></button>
      {types.map((t) => (
        <button class="chip" data-filter={t}>
          {meta[t].label} <span class="count">{counts[t]}</span>
        </button>
      ))}
      <div style="flex:1"></div>
      <label class="search-box">
        <span style="color:var(--muted);font-size:13px;">⌕</span>
        <input type="search" id="q" placeholder="搜标题、标签、参与人…" />
      </label>
    </div>

    <div class="card-grid" id="grid">
      {sortedByDate.map((i, idx) => (
        <a href={`/library/${i.id}`} class="card" data-type={i.type}
           data-search={`${i.title} ${i.summary} ${i.tags.join(' ')} ${i.people.join(' ')}`}>
          <div class="card-cover" data-type={i.type}>
            <span class="type-tag">{meta[i.type].label}</span>
            <span class="glyph">{i.title.slice(0, 1)}</span>
          </div>
          <div class="card-body">
            <div class="card-meta">
              <span>{i.date.replaceAll('-', '.')}</span>
              <span>·</span>
              <span>{i.status}</span>
            </div>
            <h3>{i.title}</h3>
            <p>{i.summary}</p>
            <div class="tags">
              {i.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="empty-state" id="empty" style="display:none;">没有匹配的条目。换个关键词或筛选试试。</div>
  </div>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('#filters .chip');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#grid .card'));
    const q = document.querySelector<HTMLInputElement>('#q');
    const empty = document.querySelector<HTMLElement>('#empty');
    let filter = 'all';

    const params = new URLSearchParams(location.search);
    const initial = params.get('type');
    if (initial && [...chips].some((c) => c.dataset.filter === initial)) {
      filter = initial;
      chips.forEach((c) => c.classList.toggle('active', c.dataset.filter === initial));
    }

    function apply() {
      const kw = (q?.value || '').trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const okType = filter === 'all' || card.dataset.type === filter;
        const okKw = !kw || (card.dataset.search || '').toLowerCase().includes(kw);
        const show = okType && okKw;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      }
      if (empty) empty.style.display = visible ? 'none' : '';
    }

    chips.forEach((c) =>
      c.addEventListener('click', () => {
        filter = c.dataset.filter || 'all';
        chips.forEach((x) => x.classList.toggle('active', x === c));
        apply();
      })
    );
    q?.addEventListener('input', apply);
    apply();
  </script>
</Base>
