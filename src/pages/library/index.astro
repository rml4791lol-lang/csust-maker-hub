---
import Base from '../../layouts/Base.astro';
import { items, typeMeta as meta, type ItemType, sortedByDate } from '../../data/items';
import { publishedItems, isExpired } from '../../data/validate';

const typeOrder: ItemType[] = [
  'guide', 'skill', 'template', 'link', 'training',
  'project', 'competition', 'activity', 'course', 'video',
];
const visible = publishedItems(items);
const types = typeOrder.filter((t) => visible.some((i) => i.type === t));
const counts = Object.fromEntries(
  types.map((t) => [t, visible.filter((i) => i.type === t).length])
) as Record<ItemType, number>;
---

<Base title="内容库" description="攻略、技能指令、模板、外部项目、培训、项目、竞赛、活动、课程、视频，每条都有参与人、状态和可复用的产出。">
  <div class="wrap page-header">
    <span class="crumb">LIBRARY / 内容库</span>
    <h1>内容库</h1>
    <p>
      按类型浏览全部内容。每条记录都有参与人、当前状态和能拿走用的产出。
      没想好从哪开始？先看<a href="/library/g01" style="color:var(--accent);">用 AI 把部门周报自动化</a>，十分钟出初稿。
    </p>
  </div>

  <div class="wrap" style="padding-bottom:80px;">
    <div class="filter-bar" id="filters">
      <button class="chip active" data-filter="all">全部 <span class="count">{visible.length}</span></button>
      {types.map((t) => (
        <button class="chip" data-filter={t}>
          {meta[t].label} <span class="count">{counts[t]}</span>
        </button>
      ))}
      <div style="flex:1"></div>
      <label class="search-box">
        <span style="color:var(--text-3);font-size:13px;">⌕</span>
        <input type="search" id="q" placeholder="搜标题、标签、参与人…" />
      </label>
    </div>

    <div class="data-list" id="grid">
      {sortedByDate.map((i) => (
        <a href={i.type === 'link' && i.extra?.url ? i.extra.url : `/library/${i.id}`}
           target={i.type === 'link' ? '_blank' : undefined}
           rel={i.type === 'link' ? 'noopener' : undefined}
           class="data-row" data-type={i.type}
           data-search={`${i.title} ${i.summary} ${i.tags.join(' ')} ${i.people.join(' ')}`}>
          <span class="data-type" data-type={i.type} aria-label={meta[i.type].label}><i>{meta[i.type].glyph}</i><span class="t-label">{meta[i.type].label}</span></span>
          <span class="data-main">
            <b>{i.title}</b>
            <i>{i.summary}</i>
          </span>
          <span class="data-people">{i.people.join(' / ')}</span>
          <span class="data-status" data-s={i.status}>{i.status}</span>
          <span class="data-date">{i.date.replaceAll('-', '.')}</span>
        </a>
      ))}
    </div>

    <div class="empty-state" id="empty" style="display:none;margin-top:16px;">没有匹配的条目。换个关键词或筛选试试。</div>

    <div style="display:flex;justify-content:space-between;gap:16px;margin-top:20px;font-family:var(--font-mono);font-size:11px;color:var(--text-3);">
      <span id="resultCount"></span>
      <span>点击任一行查看详情</span>
    </div>
  </div>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('#filters .chip');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#grid .data-row'));
    const q = document.querySelector<HTMLInputElement>('#q');
    const empty = document.querySelector<HTMLElement>('#empty');
    const resultCount = document.querySelector<HTMLElement>('#resultCount');
    let filter = 'all';

    const params = new URLSearchParams(location.search);
    const initial = params.get('type');
    if (initial && [...chips].some((c) => c.dataset.filter === initial)) {
      filter = initial;
      chips.forEach((c) => c.classList.toggle('active', c.dataset.filter === initial));
    }

    function apply() {
      const kw = (q?.value || '').trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const okType = filter === 'all' || row.dataset.type === filter;
        const okKw = !kw || (row.dataset.search || '').toLowerCase().includes(kw);
        const show = okType && okKw;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      }
      if (empty) empty.style.display = visible ? 'none' : '';
      if (resultCount) resultCount.textContent = `显示 ${visible} / ${rows.length} 条`;
    }

    chips.forEach((c) =>
      c.addEventListener('click', () => {
        filter = c.dataset.filter || 'all';
        chips.forEach((x) => x.classList.toggle('active', x === c));
        apply();
      })
    );
    q?.addEventListener('input', apply);
    apply();
  </script>
</Base>
