---
import Base from '../layouts/Base.astro';
import { groupedTools, kindLabel } from '../data/tools';
import { audienceLabel, flagEnabled } from '../data/flags';

// 功能开关：tools 关闭时本页只渲染未开放空态（导航入口同步隐藏）
const enabled = flagEnabled('tools');
---

<Base title="工具" description="创客空间的工具站、API 与内部系统目录，标注了各自的受众与状态。">
  {enabled ? (
    <>
      <div class="wrap page-header">
        <span class="crumb">TOOLS / 工具站</span>
        <h1>工具站与 API</h1>
        <p>我们自己的工具站、API 和内部系统，一条一个入口。受众标注说明这条资源面向谁；状态以站长公告为准。</p>
      </div>

      <div class="wrap" style="padding-bottom:80px;">
        {groupedTools.length === 0 && (
          <div class="empty-state">目录为空。用后台 API 往 content/tools.json 添加条目。</div>
        )}

        {groupedTools.map((g) => (
          <section class="section" style="padding:32px 0 8px;">
            <div class="section-head" style="margin-bottom:14px;padding-bottom:12px;">
              <div class="sh-left">
                <span class="sh-tag">{kindLabel[g.kind]}</span>
                <h2 class="section-title" style="font-size:var(--text-xl);">{g.label}</h2>
              </div>
              <div class="sh-right"><span class="sh-count">{g.items.length} 项</span></div>
            </div>

            <div class="data-list">
              {g.items.map((t) => (
                <a href={t.url} target="_blank" rel="noopener" class="data-row" style="grid-template-columns:minmax(0,1fr) 160px 96px;">
                  <span class="data-main">
                    <b>{t.name}</b>
                    <i>{t.desc}</i>
                  </span>
                  <span class="data-people" style="justify-self:start;">面向{audienceLabel[t.audience]}</span>
                  <span class="data-status" data-s={t.status === '维护中' ? '报名中' : t.status === '正常' ? '已上线' : '已结束'}>
                    {t.status ?? '正常'}
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </>
  ) : (
    <div class="wrap page-header" style="min-height:40vh;">
      <span class="crumb">TOOLS / 工具站</span>
      <h1>工具站与 API</h1>
      <p>这个区块当前未开放。开它的开关在后台的「功能开关」里。</p>
    </div>
  )}
</Base>
