---
import Base from '../layouts/Base.astro';
import { site, stats } from '../data/site';
import { items, typeMeta, sortedByDate } from '../data/items';
import { services } from '../data/services';
import { members } from '../data/members';

const latest = sortedByDate.slice(0, 6);
const working = sortedByDate
  .filter((i) => i.status === '进行中' || i.status === '备赛中' || i.status === '报名中')
  .slice(0, 3);
const topServices = services.slice(0, 3);
const people = members.slice(0, 8);
---

<Base>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">
          <i class="dot"></i>
          <span>{site.nameEn}</span>
          <span class="eyebrow-sep">/</span>
          <span>2019 — 2026</span>
        </span>

        <h1>
          <span class="h1-line">把想法，</span>
          <span class="h1-line"><em>做成东西。</em></span>
        </h1>

        <p class="hero-sub">
          长沙理工大学创客空间的工作台。查项目、找成员、提需求、看服务进度——
          每个入口都直接通向能用的数据，不是一段介绍。
        </p>

        <div class="hero-actions">
          <a href="/services" class="btn btn-primary">提一个需求</a>
          <a href="/library" class="btn btn-ghost">浏览内容库</a>
        </div>
      </div>

      <aside class="workbench" aria-label="本周工作台">
        <div class="wb-head">
          <span class="wb-title">本周工作台</span>
          <span class="wb-live"><i></i>进行中</span>
        </div>
        <div class="wb-list">
          {working.map((i) => (
            <a href={`/library/${i.id}`} class="wb-item">
              <span class="wb-type" data-type={i.type}>{typeMeta[i.type].label}</span>
              <span class="wb-text">
                <b>{i.title}</b>
                <i>{i.people[0]} · {i.status}</i>
              </span>
            </a>
          ))}
        </div>
        <a href="/library" class="wb-more">全部内容 <span>→</span></a>
      </aside>
    </div>

    <div class="strip">
      <div class="wrap strip-inner">
        {stats.map((s) => (
          <div class="strip-item">
            <span class="strip-num" data-count={s.v}>{s.v}</span>
            <span class="strip-label">{s.k}<i>{s.unit}</i></span>
          </div>
        ))}
        <div class="strip-item strip-note">
          <span class="strip-label">数据更新<i>2026.10</i></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 三入口 ================= -->
  <section class="section" style="padding-top:40px;">
    <div class="wrap">
      <div class="entries reveal">
        {site.entries.map((e) => (
          <a href={e.href} class="entry">
            <span class="entry-icon">{e.icon}</span>
            <h3>{e.title}</h3>
            <p>{e.desc}</p>
            <span class="go">{e.go} <span>→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 最近内容 ================= -->
  <section class="section" style="border-top:1px solid var(--line);">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <span class="sh-tag">内容库</span>
          <h2 class="section-title">最近更新</h2>
        </div>
        <div class="sh-right">
          <span class="sh-count">{items.length} 条记录</span>
          <a href="/library" class="more">全部 →</a>
        </div>
      </div>

      <div class="data-list reveal">
        {latest.map((i) => (
          <a href={`/library/${i.id}`} class="data-row">
            <span class="data-type" data-type={i.type}>{typeMeta[i.type].label}</span>
            <span class="data-main">
              <b>{i.title}</b>
              <i>{i.summary}</i>
            </span>
            <span class="data-people">{i.people.join(' / ')}</span>
            <span class="data-status" data-s={i.status}>{i.status}</span>
            <span class="data-date">{i.date.replaceAll('-', '.')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 服务 ================= -->
  <section class="section" style="border-top:1px solid var(--line);">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <span class="sh-tag">服务台</span>
          <h2 class="section-title">能接什么活</h2>
        </div>
        <div class="sh-right">
          <span class="sh-count">{services.length} 类服务</span>
          <a href="/services" class="more">服务台 →</a>
        </div>
      </div>

      <div class="service-cards reveal">
        {topServices.map((s, idx) => (
          <a href="/services" class="service-card">
            <div class="sc-head">
              <span class="sc-idx">{String(idx + 1).padStart(2, '0')}</span>
              <span class="sc-owner">{s.owner}</span>
            </div>
            <h3>{s.title}</h3>
            <p class="sc-desc">{s.desc}</p>
            <div class="sc-meta">
              <div><span>交付</span><b>{s.deliverable}</b></div>
              <div><span>周期</span><b>{s.sla}</b></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 成员 ================= -->
  <section class="section" style="border-top:1px solid var(--line);">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="sh-left">
          <span class="sh-tag">成员</span>
          <h2 class="section-title">谁在做</h2>
        </div>
        <div class="sh-right">
          <span class="sh-count">{members.length} 人</span>
          <a href="/members" class="more">全部成员 →</a>
        </div>
      </div>

      <div class="people reveal">
        {people.map((m) => (
          <a href={`/members#${m.id}`} class="person">
            <div class="avatar">{m.name.slice(0, 1)}</div>
            <h4>{m.name}{m.role ? <span style="color:var(--text-3);font-weight:400;font-size:12px;"> · {m.role}</span> : null}</h4>
            <div class="dept">{m.dept} / {m.grade}</div>
            <div class="skills">
              {m.skills.slice(0, 3).map((s) => <span class="tag">{s}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="section" style="border-top:1px solid var(--line);padding-bottom:96px;">
    <div class="wrap reveal">
      <div style="max-width:720px;">
        <span class="sh-tag">开始</span>
        <h2 class="section-title" style="font-size:clamp(26px,3.6vw,42px);margin:16px 0 18px;">
          有一个具体的活，<br class="br-desktop" />或者一个模糊的想法，都可以提。
        </h2>
        <p class="section-desc" style="margin-bottom:26px;">
          说清楚要解决什么，比说清楚要做什么更有用。
        </p>
        <div class="hero-actions">
          <a href="/services" class="btn btn-primary">提交需求</a>
          <a href="/members" class="btn btn-ghost">先看看谁在做</a>
        </div>
      </div>
    </div>
  </section>
</Base>
