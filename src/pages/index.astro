---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { members } from '../data/members';
import { profiles, groupAchievements, contributionTypeLabel } from '../data/contributions';
import { recentActivities, activityKindLabel } from '../data/activities';
import { approvedUploads } from '../data/uploads';

const groups = groupAchievements();
const activities = recentActivities(4);
const latestGroups = groups.slice(0, 5);
const topProfiles = [...profiles].sort((a, b) => b.stats.contributions - a.stats.contributions).slice(0, 4);
const photos = approvedUploads().slice(0, 6);
const photoCount = approvedUploads().length;
const deptCount = new Set(members.map((m) => m.dept)).size;
const typeLabel = (t: string) => contributionTypeLabel[t as keyof typeof contributionTypeLabel] ?? '成果';
const activityName = (id?: string) => activities.find((a) => a.id === id)?.title || '活动照片';
---

<Base>
  <div class="home-wrap">
    <!-- ========== HERO ========== -->
    <section class="hero-stage" id="heroStage">
      <div class="hero-grid-lines" aria-hidden="true"></div>
      <div class="hero-legibility" aria-hidden="true"></div>
      <div class="hero-canvas-wrap" aria-hidden="true">
        <canvas id="heroCanvas" class="hero-canvas"></canvas>
        <svg class="hero-canvas-fallback" viewBox="0 0 400 400" fill="none" aria-hidden="true">
          <g stroke="#5797ff" stroke-opacity="0.55" stroke-width="0.8">
            <circle cx="200" cy="200" r="140" />
            <circle cx="200" cy="200" r="105" stroke-opacity="0.3" />
            <path d="M200 60 L321 270 L79 270 Z" />
            <path d="M200 60 L200 340 M79 270 L321 270" stroke-opacity="0.3" />
            <circle cx="200" cy="60" r="3" fill="#50d6e8" stroke="none" />
            <circle cx="79" cy="270" r="3" fill="#50d6e8" stroke="none" />
            <circle cx="321" cy="270" r="3" fill="#50d6e8" stroke="none" />
          </g>
        </svg>
      </div>

      <div class="hero-inner-grid">
        <div class="hero-copy-block">
          <span class="hero-eyebrow"><i></i>{site.fullName} · 云塘校区科创港</span>
          <h1>{site.tagline[0]}<br />把想法<span class="accent">做出来</span>。</h1>
          <p class="hero-lead">{site.about.lead}这里记录协会的活动与成果，也记录每个人做过什么、擅长什么。</p>
          <div class="hero-actions">
            <a href="/achievements" class="btn btn-primary">进入活动与成果 <span class="ar">→</span></a>
            <a href="/contribute" class="btn btn-ghost">提交我的记录</a>
          </div>
        </div>

        <aside class="hero-preview" aria-label="最近成果">
          <div class="hero-preview-head">
            <b>最近成果</b>
            <span class="mono">共 {groups.length} 条</span>
          </div>
          <div class="hero-preview-list">
            {latestGroups.map((g) => (
              <a class="hero-preview-row" href="/achievements">
                <span class="ep-date">{g.date.slice(5).replace('-', '.')}</span>
                <span class="ep-title">{g.title}</span>
                <span class="ep-tag">{typeLabel(g.type)}</span>
              </a>
            ))}
          </div>
          <a class="hero-preview-more" href="/achievements">查看全部成果 <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    </section>

    <!-- ========== 数据概览 ========== -->
    <section class="metric-row" aria-label="协会数据概览">
      <a class="metric-cell" href="/achievements">
        <span class="metric-label">活动场次 <span class="ar">→</span></span>
        <span class="metric-value" data-count={activities.length}>{activities.length}</span>
        <span class="metric-sub">近期活动记录</span>
      </a>
      <a class="metric-cell" href="/achievements">
        <span class="metric-label">成果条目 <span class="ar">→</span></span>
        <span class="metric-value" data-count={groups.length}>{groups.length}</span>
        <span class="metric-sub">项目 / 竞赛 / 分享</span>
      </a>
      <a class="metric-cell" href="/gallery">
        <span class="metric-label">现场照片 <span class="ar">→</span></span>
        <span class="metric-value" data-count={photoCount}>{photoCount}</span>
        <span class="metric-sub">审核通过的现场记录</span>
      </a>
      <a class="metric-cell" href="/members">
        <span class="metric-label">覆盖部门 <span class="ar">→</span></span>
        <span class="metric-value" data-count={deptCount}>{deptCount}</span>
        <span class="metric-sub">技术 / 竞赛 / 组织 / 宣传 / 创新创业</span>
      </a>
    </section>

    <!-- ========== 工作台面板 ========== -->
    <div class="dash-grid">
      <section class="panel">
        <div class="panel-head">
          <h2>活动记录</h2>
          <a href="/achievements">查看全部 →</a>
        </div>
        <div class="panel-list">
          {activities.map((a) => (
            <a class="panel-row" href={`/achievements#${a.id}`}>
              <span class="pr-icon">{activityKindLabel[a.kind].slice(0, 1)}</span>
              <span class="pr-main">
                <b>{a.title}</b>
                <span>{a.date.replaceAll('-', '.')}{a.location ? ' · ' + a.location : ''}</span>
              </span>
              <span class="pr-tag">{activityKindLabel[a.kind]}</span>
            </a>
          ))}
        </div>
        <a class="panel-foot" href="/achievements">去活动与成果看现场 <span aria-hidden="true">→</span></a>
      </section>

      <section class="panel">
        <div class="panel-head">
          <h2>最新成果</h2>
          <a href="/achievements">查看全部 →</a>
        </div>
        <div class="panel-list">
          {latestGroups.slice(0, 4).map((g) => (
            <a class="panel-row" href="/achievements">
              <span class="pr-icon">{typeLabel(g.type).slice(0, 1)}</span>
              <span class="pr-main">
                <b>{g.title}</b>
                <span>{g.members.slice(0, 3).map((m) => m.name).join('、')} · {g.date.replaceAll('-', '.')}</span>
              </span>
              <span class="pr-tag">{typeLabel(g.type)}</span>
            </a>
          ))}
        </div>
        <a class="panel-foot" href="/contribute">提交我的记录 <span aria-hidden="true">→</span></a>
      </section>
    </div>

    <div class="dash-grid">
      <section class="panel">
        <div class="panel-head">
          <h2>成员能力</h2>
          <a href="/members">查看全部 →</a>
        </div>
        <div class="member-mini-grid">
          {topProfiles.map((p) => (
            <a class="member-mini" href={`/members/${p.memberId}`}>
              <span class="member-mini-top">
                <span class="member-mini-avatar">{p.name.slice(0, 1)}</span>
                <span>
                  <b>{p.name}</b>
                  <small>{p.dept}{p.role ? ' · ' + p.role : ''}</small>
                </span>
              </span>
              <span class="member-mini-tags">
                {p.focusTags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
              </span>
            </a>
          ))}
        </div>
        <a class="panel-foot" href="/members">看全部成员档案 <span aria-hidden="true">→</span></a>
      </section>

      <section class="panel">
        <div class="panel-head">
          <h2>现场相册</h2>
          <a href="/gallery">查看全部 →</a>
        </div>
        {photos.length ? (
          <div class="photo-mini-grid">
            {photos.map((p) => (
              <a class="photo-mini" href="/gallery">
                <img src={p.url} alt={p.caption || '协会活动现场照片'} loading="lazy" />
                <span>{p.caption || activityName(p.activityId)}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="panel-empty">还没有现场照片，登录后上传第一张。</p>
        )}
        <a class="panel-foot" href="/gallery">上传 / 浏览现场照片 <span aria-hidden="true">→</span></a>
      </section>
    </div>

    <!-- ========== CTA ========== -->
    <section class="cta-band">
      <div class="cta-inner">
        <div class="sec-index"><b>05</b><span class="rule"></span>开始</div>
        <h2>做过的事，<span class="accent" style="color: var(--cyan);">值得被记下来。</span></h2>
        <div class="cta-row" style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
          <a href="/contribute" class="btn btn-primary">提交我的记录 <span class="ar">→</span></a>
          <a href="/achievements" class="btn btn-ghost">看看活动与成果</a>
        </div>
      </div>
    </section>
  </div>

  <script>
    const stage = document.getElementById('heroStage');
    const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement | null;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = window.matchMedia('(max-width: 767px)').matches;
    if (!stage || !canvas || reduce || small) {
      stage?.classList.add('no-scene');
    } else {
      import('three')
        .then((THREE) => {
          const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
          camera.position.set(0, 0, 6);

          const group = new THREE.Group();
          scene.add(group);

          const knot = new THREE.Mesh(
            new THREE.TorusKnotGeometry(1.15, 0.32, 220, 32),
            new THREE.MeshStandardMaterial({
              color: 0x151b26,
              metalness: 0.92,
              roughness: 0.42,
              emissive: 0x3d7bfd,
              emissiveIntensity: 0.06,
            })
          );
          group.add(knot);

          const wire = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.9, 1),
            new THREE.MeshBasicMaterial({ color: 0x5797ff, wireframe: true, transparent: true, opacity: 0.14 })
          );
          group.add(wire);

          scene.add(new THREE.AmbientLight(0x9fb8d8, 0.25));
          const key = new THREE.PointLight(0x5797ff, 90, 20);
          key.position.set(3.2, 2.4, 4);
          scene.add(key);
          const rim = new THREE.PointLight(0x50d6e8, 70, 20);
          rim.position.set(-3.4, -2.2, 2.4);
          scene.add(rim);

          let px = 0;
          let py = 0;
          stage.addEventListener('pointermove', (event) => {
            const b = stage.getBoundingClientRect();
            px = ((event.clientX - b.left) / b.width) * 2 - 1;
            py = ((event.clientY - b.top) / b.height) * 2 - 1;
          });

          const resize = () => {
            const w = stage.clientWidth;
            const h = stage.clientHeight;
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
          };
          resize();
          window.addEventListener('resize', resize);

          const clock = new THREE.Clock();
          const tick = () => {
            const t = clock.getElapsedTime();
            group.rotation.y = t * 0.18;
            group.rotation.x = Math.sin(t * 0.22) * 0.18;
            key.position.x = 3.2 + px * 1.4;
            key.position.y = 2.4 - py * 1.2;
            group.position.x += (px * 0.18 - group.position.x) * 0.04;
            group.position.y += (-py * 0.14 - group.position.y) * 0.04;
            renderer.render(scene, camera);
            requestAnimationFrame(tick);
          };
          tick();
        })
        .catch(() => stage.classList.add('no-scene'));
    }
  </script>
</Base>
