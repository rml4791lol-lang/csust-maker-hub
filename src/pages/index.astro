---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { profiles, groupAchievements, contributionTypeLabel } from '../data/contributions';
import { recentActivities, activityKindLabel } from '../data/activities';
import { memberExists } from '../data/members';

const slides = site.heroSlides;
const groups = groupAchievements();
const recent = groups.slice(0, 5);
const activities = recentActivities(3);
const topProfiles = [...profiles].sort((a, b) => b.stats.contributions - a.stats.contributions).slice(0, 4);
const typeLabel = (t: string) => contributionTypeLabel[t as keyof typeof contributionTypeLabel] ?? '成果';
---

<Base>
  <!-- ================= 首屏：科创港照片翻页 ================= -->
  <section class="hero hero-simple hero-port">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="eyebrow-pill">
          <span class="beam"></span>
          {site.fullName}
        </span>
        <h1>
          {site.tagline[0]}<span class="line-2 grad">{site.tagline[1]}</span>
        </h1>
        <p class="lead">{site.about.lead}</p>
        <div class="cta-row">
          <a href="/achievements" class="btn btn-primary">看活动与成果 <span class="ar">→</span></a>
          <a href="/contribute" class="btn btn-ghost">提交我的记录</a>
        </div>
      </div>

      <aside class="hero-carousel" data-carousel aria-roledescription="轮播" aria-label="科创港照片">
        <div class="carousel-track" data-track>
          {slides.map((s, i) => (
            <figure class="carousel-slide">
              <img src={s.src} alt={s.label} loading={i === 0 ? 'eager' : 'lazy'} />
              <figcaption>{s.label}</figcaption>
            </figure>
          ))}
        </div>
        <button class="carousel-arrow carousel-prev" data-prev aria-label="上一张">‹</button>
        <button class="carousel-arrow carousel-next" data-next aria-label="下一张">›</button>
        <div class="carousel-dots" data-dots aria-label="选择照片">
          {slides.map((_, i) => (
            <button class={i === 0 ? 'is-active' : ''} data-dot={i} aria-label={`第 ${i + 1} 张`}></button>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <!-- ================= 活动记录 ================= -->
  <section class="section" id="activities">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="sec-index"><b>01</b><span class="rule"></span>活动记录</div>
          <h2 class="sec-title">协会最近办了什么</h2>
        </div>
        <a class="sec-more" href="/achievements">全部活动 <span class="ar">→</span></a>
      </div>

      <div class="activity-grid activity-grid-3">
        {activities.map((a) => (
          <a class="activity-card" href={`/achievements#${a.id}`}>
            <span class="activity-cover">
              <img src={a.cover} alt={a.title} loading="lazy" />
              <span class="activity-kind">{activityKindLabel[a.kind]}</span>
            </span>
            <span class="activity-body">
              <b>{a.title}</b>
              <span class="activity-meta">{a.date.replaceAll('-', '.')}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 成员成果 ================= -->
  <section class="section" id="achievements">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="sec-index"><b>02</b><span class="rule"></span>成员成果</div>
          <h2 class="sec-title">成员们做出来的东西</h2>
        </div>
        <a class="sec-more" href="/achievements">全部成果 <span class="ar">→</span></a>
      </div>

      <div class="mini-list">
        {recent.map((g) => (
          <a class="mini-row" href={`/achievements#${g.ids[0]}`}>
            <span class="mini-type">{typeLabel(g.type)}</span>
            <b>{g.title}</b>
            <span class="mini-date">{g.date.replaceAll('-', '.')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 成员能力 ================= -->
  <section class="section" id="members">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="sec-index"><b>03</b><span class="rule"></span>成员能力</div>
          <h2 class="sec-title">谁在做什么</h2>
        </div>
        <a class="sec-more" href="/members">全部成员 <span class="ar">→</span></a>
      </div>

      <div class="member-simple-grid">
        {topProfiles.map((p) => (
          <a class="member-simple" href={`/members/${p.memberId}`}>
            <span class="member-simple-head">
              <span class="ach-avatar">{p.name.slice(0, 1)}</span>
              <b>{p.name}</b>
              <span class="member-simple-dept">{p.dept}</span>
            </span>
            <span class="member-simple-tags">
              {p.focusTags.slice(0, 3).map((t) => <span class="skill-chip">{t}</span>)}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 关于协会 ================= -->
  <section class="section" id="about">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="sec-index"><b>04</b><span class="rule"></span>关于协会</div>
          <h2 class="sec-title">{site.about.lead}</h2>
        </div>
      </div>

      <div class="about-facts">
        {site.about.facts.map((f) => (
          <div class="about-fact">
            <span class="mono">{f.k}</span>
            <b>{f.v}</b>
          </div>
        ))}
        <div class="about-fact">
          <span class="mono">联系</span>
          <b><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></b>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="cta-band">
    <div class="wrap cta-inner">
      <div class="sec-index"><b>05</b><span class="rule"></span>开始</div>
      <h2>做过的事，<span class="grad">值得被记下来。</span></h2>
      <div class="cta-row">
        <a href="/contribute" class="btn btn-primary">提交我的记录 <span class="ar">→</span></a>
        <a href="/achievements" class="btn btn-ghost">看看活动与成果</a>
      </div>
    </div>
  </section>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-track]');
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
      const slides = track ? Array.from(track.children) : [];
      if (!track || slides.length === 0) return;
      let index = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      const render = () => {
        track.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((d, i) => d.classList.toggle('is-active', i === index));
      };
      const go = (next: number) => {
        index = (next + slides.length) % slides.length;
        render();
      };
      const play = () => {
        if (reduce || timer) return;
        timer = setInterval(() => go(index + 1), 5200);
      };
      const pause = () => {
        if (timer) { clearInterval(timer); timer = null; }
      };

      root.querySelector('[data-prev]')?.addEventListener('click', () => { pause(); go(index - 1); play(); });
      root.querySelector('[data-next]')?.addEventListener('click', () => { pause(); go(index + 1); play(); });
      dots.forEach((d, i) => d.addEventListener('click', () => { pause(); go(i); play(); }));
      root.addEventListener('pointerenter', pause);
      root.addEventListener('pointerleave', play);
      render();
      play();
    });
  </script>
</Base>
