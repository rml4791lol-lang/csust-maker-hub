---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { groupAchievements, contributionTypeLabel } from '../data/contributions';

const groups = groupAchievements().slice(0, 5);
const typeLabel = (t: string) => contributionTypeLabel[t as keyof typeof contributionTypeLabel] ?? '成果';
---

<Base>
  <!-- ========== 首屏：极简，只留一句话和两个入口 ========== -->
  <section class="home-hero" id="heroStage">
    <div class="home-hero-bg" aria-hidden="true">
      <span class="home-glow home-glow-a"></span>
      <span class="home-glow home-glow-b"></span>
      <span class="home-grid"></span>
      <svg class="home-ring home-ring-a" viewBox="0 0 800 800" fill="none">
        <circle cx="400" cy="400" r="330" stroke="currentColor" stroke-opacity="0.5" />
        <circle cx="400" cy="400" r="260" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="3 9" />
        <path d="M400 70 L700 640 L100 640 Z" stroke="currentColor" stroke-opacity="0.28" />
        <path d="M400 70 L400 730 M100 640 L700 640" stroke="currentColor" stroke-opacity="0.16" />
      </svg>
      <svg class="home-ring home-ring-b" viewBox="0 0 600 600" fill="none">
        <circle cx="300" cy="300" r="240" stroke="currentColor" stroke-opacity="0.35" stroke-dasharray="1 12" />
        <path d="M300 60 L540 460 L60 460 Z" stroke="currentColor" stroke-opacity="0.2" />
      </svg>
      <canvas id="heroCanvas" class="home-canvas"></canvas>
    </div>

    <div class="home-hero-inner">
      <div class="home-copy">
        <span class="home-eyebrow"><i></i>长沙理工大学 AI 创客协会</span>
        <h1 class="home-title">把 AI 用起来，<br /><span>把想法做出来。</span></h1>
        <div class="home-cta">
          <a href="/achievements" class="btn btn-primary">活动与成果 <span class="ar">→</span></a>
          <a href="/contribute" class="btn btn-ghost">提交记录</a>
        </div>
      </div>
    </div>

    <div class="home-hero-foot" aria-hidden="true">
      <span>SCROLL</span>
      <span class="home-hero-line"></span>
      <span>{groups.length} RECENT WORKS</span>
    </div>
  </section>

  <!-- ========== 唯一内容区：精选成果 ========== -->
  <section class="home-featured" aria-label="精选成果">
    <header class="home-featured-head">
      <div>
        <span class="home-featured-kicker">SELECTED / 精选</span>
        <h2>最近做出来的东西。</h2>
      </div>
      <a href="/achievements" class="home-featured-more">看全部 <span aria-hidden="true">→</span></a>
    </header>

    <ol class="home-featured-list">
      {groups.map((g, i) => (
        <li>
          <a href="/achievements" class="home-featured-row">
            <span class="home-featured-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="home-featured-main">
              <b>{g.title}</b>
              <small>{g.members.slice(0, 3).map((m) => m.name).join('、')} · {g.date.replaceAll('-', '.')}</small>
            </span>
            <span class="home-featured-type">{typeLabel(g.type)}</span>
            <span class="home-featured-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <footer class="home-featured-foot">
      <span class="mono">ASSOCIATION OF AI MAKERS · CSUST</span>
      <a href="/members" class="home-featured-link">成员能力 →</a>
      <a href="/gallery" class="home-featured-link">现场相册 →</a>
      <a href="/contribute" class="home-featured-link">提交记录 →</a>
    </footer>
  </section>

  <script>
    const stage = document.getElementById('heroStage');
    const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement | null;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = window.matchMedia('(max-width: 900px)').matches;
    if (!stage || !canvas || reduce || small) {
      stage?.classList.add('no-scene');
    } else {
      import('three')
        .then((THREE) => {
          const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
          camera.position.set(0, 0, 7);

          const group = new THREE.Group();
          scene.add(group);

          const knot = new THREE.Mesh(
            new THREE.IcosahedronGeometry(2.05, 2),
            new THREE.MeshStandardMaterial({
              color: 0x0e1624,
              metalness: 0.94,
              roughness: 0.4,
              emissive: 0x2f6fe0,
              emissiveIntensity: 0.1,
            })
          );
          group.add(knot);

          const wire = new THREE.Mesh(
            new THREE.IcosahedronGeometry(2.62, 1),
            new THREE.MeshBasicMaterial({ color: 0x5797ff, wireframe: true, transparent: true, opacity: 0.2 })
          );
          group.add(wire);

          const outer = new THREE.Mesh(
            new THREE.IcosahedronGeometry(3.1, 1),
            new THREE.MeshBasicMaterial({ color: 0x50d6e8, wireframe: true, transparent: true, opacity: 0.07 })
          );
          group.add(outer);

          scene.add(new THREE.AmbientLight(0x9fb8d8, 0.3));
          const key = new THREE.PointLight(0x5797ff, 140, 26);
          key.position.set(4.2, 3.2, 5);
          scene.add(key);
          const rim = new THREE.PointLight(0x50d6e8, 110, 26);
          rim.position.set(-4.4, -2.8, 3);
          scene.add(rim);

          let px = 0;
          let py = 0;
          stage.addEventListener('pointermove', (event) => {
            const b = stage.getBoundingClientRect();
            px = ((event.clientX - b.left) / b.width) * 2 - 1;
            py = ((event.clientY - b.top) / b.height) * 2 - 1;
          });

          const resize = () => {
            const w = stage.clientWidth;
            const h = stage.clientHeight;
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
          };
          resize();
          window.addEventListener('resize', resize);

          const clock = new THREE.Clock();
          const tick = () => {
            const t = clock.getElapsedTime();
            group.rotation.y = t * 0.14;
            group.rotation.x = Math.sin(t * 0.18) * 0.2;
            key.position.x = 4.2 + px * 1.6;
            key.position.y = 3.2 - py * 1.4;
            group.position.x += (px * 0.2 - group.position.x) * 0.04;
            group.position.y += (-py * 0.16 - group.position.y) * 0.04;
            renderer.render(scene, camera);
            requestAnimationFrame(tick);
          };
          tick();
        })
        .catch(() => stage.classList.add('no-scene'));
    }
  </script>
</Base>
