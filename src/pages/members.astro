---
import Base from '../layouts/Base.astro';
import { members, depts } from '../data/members';
import { items } from '../data/items';

const itemMap = new Map(items.map((i) => [i.id, i]));
const deptCounts = Object.fromEntries(depts.map((d) => [d, members.filter((m) => m.dept === d).length]));
---

<Base title="成员" description="创客空间成员的能力、参与项目和成果，可按部门筛选和检索。">
  <div class="wrap page-header">
    <span class="crumb">PEOPLE / 成员</span>
    <h1>成员</h1>
    <p>每个人的能力、参与项目和成果。按部门筛，或者直接搜技能。</p>
  </div>

  <div class="wrap" style="padding-bottom:80px;">
    <div class="filter-bar" id="filters">
      <button class="chip active" data-filter="all">全部 <span class="count">{members.length}</span></button>
      {depts.map((d) => (
        <button class="chip" data-filter={d}>{d} <span class="count">{deptCounts[d]}</span></button>
      ))}
      <div style="flex:1"></div>
      <label class="search-box">
        <span style="color:var(--text-3);font-size:13px;">⌕</span>
        <input type="search" id="q" placeholder="搜姓名、技能…" />
      </label>
    </div>

    <div style="border:1px solid var(--line);border-radius:10px;overflow:hidden;">
      <table class="member-table" id="grid">
        <thead>
          <tr>
            <th style="width:22%;">姓名</th>
            <th style="width:16%;">部门</th>
            <th style="width:10%;">年级</th>
            <th style="width:30%;">技能</th>
            <th style="width:22%;">参与项目</th>
          </tr>
        </thead>
        <tbody>
          {members.map((m) => {
            const projs = m.projects.map((id) => itemMap.get(id)).filter(Boolean);
            return (
              <tr data-dept={m.dept}
                  data-search={`${m.name} ${m.dept} ${m.grade} ${m.skills.join(' ')} ${m.bio ?? ''}`}>
                <td>
                  <span class="m-name">{m.name}</span>
                  {m.role ? <span class="m-role">{m.role}</span> : null}
                </td>
                <td class="m-dept">{m.dept}</td>
                <td style="color:var(--text-3);font-size:12.5px;">{m.grade}</td>
                <td>
                  <span class="m-skills">
                    {m.skills.map((s) => <span class="tag">{s}</span>)}
                  </span>
                </td>
                <td class="m-proj">
                  {projs.length
                    ? projs.map((p: any) => <a href={`/library/${p.id}`} style="border-bottom:1px dotted var(--line-strong);">{p.title}</a>)
                    : <span style="color:var(--text-3);">—</span>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <div class="empty-state" id="empty" style="display:none;margin-top:16px;">没有匹配的成员。</div>

    <div style="display:flex;justify-content:space-between;gap:16px;margin-top:16px;font-family:var(--font-mono);font-size:11px;color:var(--text-3);">
      <span id="resultCount"></span>
      <span>点击项目名查看详情</span>
    </div>
  </div>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('#filters .chip');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#grid tbody tr'));
    const q = document.querySelector<HTMLInputElement>('#q');
    const empty = document.querySelector<HTMLElement>('#empty');
    const resultCount = document.querySelector<HTMLElement>('#resultCount');
    let filter = 'all';

    function apply() {
      const kw = (q?.value || '').trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const okDept = filter === 'all' || row.dataset.dept === filter;
        const okKw = !kw || (row.dataset.search || '').toLowerCase().includes(kw);
        const show = okDept && okKw;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      }
      if (empty) empty.style.display = visible ? 'none' : '';
      if (resultCount) resultCount.textContent = `显示 ${visible} / ${rows.length} 人`;
    }

    chips.forEach((c) =>
      c.addEventListener('click', () => {
        filter = c.dataset.filter || 'all';
        chips.forEach((x) => x.classList.toggle('active', x === c));
        apply();
      })
    );
    q?.addEventListener('input', apply);
    apply();
  </script>
</Base>
