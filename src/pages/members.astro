---
import Base from '../layouts/Base.astro';
import { members, depts } from '../data/members';
import { profiles, publishedSubmissions, contributionTypeLabel } from '../data/contributions';
import { site } from '../data/site';

const profileMap = new Map(profiles.map((p) => [p.memberId, p]));

// 能力与成果总览：部门产出 / 成果类型 / 高频能力标签 / 贡献榜
const subs = publishedSubmissions();
const byDept = depts.map((d) => ({ label: d, n: subs.filter((s) => s.dept === d).length }));
const byType = Object.entries(contributionTypeLabel)
  .map(([k, label]) => ({ key: k, label, n: subs.filter((s) => s.type === k).length }))
  .filter((t) => t.n > 0)
  .sort((a, b) => b.n - a.n);
const maxDept = Math.max(...byDept.map((x) => x.n), 1);
const maxType = Math.max(...byType.map((x) => x.n), 1);
const skillFreq = new Map<string, number>();
for (const p of profiles) for (const t of p.focusTags) skillFreq.set(t, (skillFreq.get(t) ?? 0) + 1);
const topSkills = [...skillFreq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 16);
const topPeople = [...profiles].sort((a, b) => b.stats.contributions - a.stats.contributions).slice(0, 5);
---

<Base title="成员能力" description="长沙理工大学 AI 创客协会成员列表与能力画像：做过什么、擅长什么。">
  <div class="wrap page-header">
    <span class="crumb">MEMBERS / 成员能力</span>
    <h1>成员与能力画像</h1>
    <p>成员自己提交成果，系统自动汇总能力标签与代表成果。点名字看个人档案。</p>
    <div class="hero-actions" style="margin-top:20px;">
      <a href="/contribute" class="btn btn-primary">提交我的记录 <span class="ar">→</span></a>
      <a href="/achievements" class="btn btn-ghost">看协会成果</a>
    </div>
  </div>

  <div class="wrap" style="padding-bottom:96px;">
    <!-- 能力总览 -->
    <section class="section" id="ability" style="padding-top:8px;">
      <div class="section-head">
        <div>
          <div class="sec-index"><b>01</b><span class="rule"></span>能力总览</div>
          <h2 class="sec-title">谁在做什么</h2>
        </div>
        <a class="sec-more" href="/achievements">看全部成果 <span class="ar">→</span></a>
      </div>

      <div class="ability-grid">
        <div class="ability-panel">
          <h3>部门产出</h3>
          {byDept.map((d) => (
            <div class="ability-row">
              <span class="hbar-label">{d.label}</span>
              <div class="hbar-track"><div class="hbar" style={`width:${Math.round((d.n / maxDept) * 100)}%`}></div></div>
              <span class="hbar-num">{d.n}</span>
            </div>
          ))}
        </div>
        <div class="ability-panel">
          <h3>成果类型</h3>
          {byType.map((t) => (
            <div class="ability-row">
              <span class="hbar-label">{t.label}</span>
              <div class="hbar-track"><div class="hbar hbar-neutral" style={`width:${Math.round((t.n / maxType) * 100)}%`}></div></div>
              <span class="hbar-num">{t.n}</span>
            </div>
          ))}
        </div>
        <div class="ability-panel" style="grid-column:1 / -1;">
          <h3>高频能力标签</h3>
          <div class="ability-tags">
            {topSkills.map(([k, n]) => <span class="skill-chip">{k} <b style="color:var(--fg-4);font-weight:400;">{n}</b></span>)}
          </div>
        </div>
        <div class="ability-panel" style="grid-column:1 / -1;">
          <h3>成果记录 Top 5</h3>
          <div class="ability-top">
            {topPeople.map((p, i) => (
              <a class="ability-person" href={`/members/${p.memberId}`}>
                <span class="ach-avatar">{p.name.slice(0, 1)}</span>
                <b>#{i + 1} {p.name}</b>
                <span>{p.dept}{p.role ? ' · ' + p.role : ''}</span>
                <span>{p.stats.contributions} 条成果</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 部门 -->
    <section class="section" id="structure" style="padding-top:64px;">
      <div class="section-head">
        <div>
          <div class="sec-index"><b>02</b><span class="rule"></span>五个部门</div>
          <h2 class="sec-title">协会怎么分工</h2>
        </div>
      </div>

      <div class="dept-grid">
        {site.departments.map((d) => (
          <div class="dept-card">
            <span class="dept-name">{d.name}</span>
            <p class="dept-duty">{d.duty}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 成员列表 -->
    <section class="section" id="roster" style="padding-top:64px;">
      <div class="section-head">
        <div>
          <div class="sec-index"><b>03</b><span class="rule"></span>成员档案</div>
          <h2 class="sec-title">成员清单</h2>
        </div>
      </div>

      <div class="member-cards">
        {members.map((m) => (
          <a class="member-card" href={`/members/${m.id}`}>
            <span class="archive-top">
              <span class="archive-avatar">{m.name.slice(0, 1)}</span>
              <span>
                <span class="archive-name">{m.name}{m.role ? ` · ${m.role}` : ''}</span>
                <span class="archive-meta" style="display:block;">{m.dept}</span>
              </span>
            </span>
            <span class="archive-tags">
              {m.skills.slice(0, 3).map((s) => <span class="skill-chip">{s}</span>)}
            </span>
            <span class="archive-stats"><span>查看档案 →</span></span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
