---
import Base from '../layouts/Base.astro';

const identityOptions = [
  { value: 'dept_member', label: '部门成员' },
  { value: 'dept_lead', label: '部门部长' },
  { value: 'vice_president', label: '副会长' },
  { value: 'president', label: '会长' },
  { value: 'teacher', label: '老师' },
  { value: 'partner', label: '合伙人' },
  { value: 'other', label: '其他' },
];
const depts = ['技术部', '竞赛部', '组织部', '宣传部', '创新创业部'];
---

<Base title="注册" description="长沙理工大学 AI 创客协会成员注册：邮箱/手机号账号 + 实名资料，管理员审核后开通。" noindex>
  <div class="wrap page-header">
    <span class="crumb">REGISTER / 注册</span>
    <h1>成员注册</h1>
    <p>用邮箱或手机号注册账号，填写实名资料；提交后由管理员审核，通过后即可登录投稿。</p>
  </div>

  <div class="wrap" style="padding-bottom:100px;max-width:720px;">
    <form class="form-panel" id="registerForm" novalidate>
      <div class="form-grid">
        <div class="field">
          <label for="email">邮箱<i>*</i></label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
        </div>
        <div class="field">
          <label for="phone">手机号<i>*</i></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="11 位手机号" required />
          <span class="hint">仅管理员可见，用于联系。</span>
        </div>

        <div class="field full">
          <label for="realName">真实姓名<i>*</i></label>
          <input id="realName" name="realName" placeholder="与协会登记一致的真实姓名" maxlength="20" required />
        </div>

        <div class="field full">
          <label>协会身份<i>*</i></label>
          <div class="choice-group" id="identityGroup">
            {identityOptions.map((o, i) => (
              <label class="choice">
                <input type="radio" name="identity" value={o.value} checked={i === 0} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="field full" id="deptField">
          <label>所属部门<i>*</i></label>
          <div class="choice-group" id="deptGroup">
            {depts.map((d) => (
              <label class="choice">
                <input type="radio" name="dept" value={d} />
                <span>{d}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="field">
          <label for="password">设置密码<i>*</i></label>
          <input id="password" name="password" type="password" autocomplete="new-password" placeholder="至少 8 位，含字母和数字" required />
        </div>
        <div class="field">
          <label for="password2">确认密码<i>*</i></label>
          <input id="password2" name="password2" type="password" autocomplete="new-password" required />
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="registerBtn">提交注册 <span class="ar">→</span></button>
        <a href="/login" class="btn btn-ghost">已有账号？去登录</a>
        <span class="form-msg" id="registerMsg" role="status" aria-live="polite"></span>
      </div>
    </form>
  </div>

  <script>
    const form = document.getElementById('registerForm') as HTMLFormElement | null;
    const msg = document.getElementById('registerMsg');
    const btn = document.getElementById('registerBtn') as HTMLButtonElement | null;
    const deptField = document.getElementById('deptField');
    const show = (text: string, kind: 'ok' | 'err' | '' = '') => {
      if (!msg) return;
      msg.textContent = text;
      msg.className = 'form-msg' + (kind ? ' ' + kind : '');
    };

    const syncDept = () => {
      const identity = form?.querySelector<HTMLInputElement>('input[name="identity"]:checked')?.value || '';
      const needsDept = identity === 'dept_member' || identity === 'dept_lead';
      if (deptField) deptField.hidden = !needsDept;
    };
    form?.querySelectorAll<HTMLInputElement>('input[name="identity"]').forEach((el) => el.addEventListener('change', syncDept));
    syncDept();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form || !btn) return;
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (!data.email) return show('请填写邮箱', 'err');
      if (!data.phone) return show('请填写手机号', 'err');
      if (!data.realName || data.realName.trim().length < 2) return show('请填写真实姓名', 'err');
      if (!data.identity) return show('请选择协会身份', 'err');
      const needsDept = data.identity === 'dept_member' || data.identity === 'dept_lead';
      if (needsDept && !data.dept) return show('请选择所属部门', 'err');
      if (!data.password || data.password.length < 8) return show('密码至少 8 位', 'err');
      if (!/[A-Za-z]/.test(data.password) || !/\d/.test(data.password)) return show('密码需要同时包含字母和数字', 'err');
      if (data.password !== data.password2) return show('两次密码不一致', 'err');

      btn.disabled = true;
      show('提交中…');
      try {
        const res = await fetch('/admin/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: data.email,
            phone: data.phone,
            realName: data.realName,
            password: data.password,
            identity: data.identity,
            dept: needsDept ? data.dept : '其他',
          }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.error || '注册失败');
        form.reset();
        syncDept();
        show('注册已提交，等待管理员审核；通过后就可以登录了。', 'ok');
      } catch (err: any) {
        show(err.message || '注册失败', 'err');
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</Base>
