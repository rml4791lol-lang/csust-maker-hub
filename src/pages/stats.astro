---
import Base from '../layouts/Base.astro';
import { items, typeMeta } from '../data/items';
import { members, depts } from '../data/members';
import { stats } from '../data/site';

const types = ['guide', 'skill', 'template', 'link', 'training'] as const;

// 类型分布
const byType = types.map((t) => {
  const n = items.filter((i) => i.type === t).length;
  return { key: t, label: typeMeta[t].label, n, pct: Math.round((n / items.length) * 100) };
});

// 月度更新
const monthMap = new Map<string, number>();
for (const i of items) {
  const m = i.date.slice(0, 7);
  monthMap.set(m, (monthMap.get(m) || 0) + 1);
}
const months = [...monthMap.keys()].sort();
const monthData = months.map((m) => ({ m, n: monthMap.get(m) || 0 }));
const maxMonth = Math.max(...monthData.map((d) => d.n), 1);

// 部门分布
const byDept = depts.map((d) => ({
  d,
  n: members.filter((m) => m.dept === d).length,
}));
const maxDept = Math.max(...byDept.map((x) => x.n), 1);

// 内容状态
const contentStatus = ['已完成', '已上线', '已结束', '可学习', '进行中', '备赛中', '报名中'];
const contentStatusData = contentStatus
  .map((s) => ({ s, n: items.filter((i) => i.status === s).length }))
  .filter((x) => x.n > 0);
const maxStatus = Math.max(...contentStatusData.map((x) => x.n), 1);

// 计算环形图角度
let acc = 0;
const donut = byType.map((t) => {
  const start = acc;
  acc += (t.n / items.length) * 360;
  return { ...t, start, end: acc };
});
const colors: Record<string, string> = {
  project: '#b45309',
  competition: '#a16207',
  activity: '#1d4ed8',
  course: '#15803d',
  video: '#b91c1c',
};
---

<Base title="数据" description="创客空间的内容、成员数据看板。">
  <div class="wrap page-header">
    <span class="crumb">DATA / 数据看板</span>
    <h1>数据看板</h1>
    <p>内容、成员的实时聚合。所有数字从内容库自动算出来，不手工维护。</p>
  </div>

  <div class="wrap" style="padding-bottom:80px;">
    <!-- 概览 -->
    <div class="stat-cards">
      {stats.map((s) => (
        <div class="stat-card">
          <span class="stat-label">{s.k}</span>
          <span class="stat-value">{s.v}<i>{s.unit}</i></span>
        </div>
      ))}
    </div>

    <div class="chart-grid">
      <!-- 月度更新 -->
      <section class="panel">
        <div class="panel-head">
          <h3>每月新增内容</h3>
          <span>近 {monthData.length} 个月</span>
        </div>
        <div class="bar-chart">
          {monthData.map((d) => (
            <div class="bar-col">
              <span class="bar-num">{d.n}</span>
              <div class="bar-wrap">
                <div class="bar" style={`height:${Math.round((d.n / maxMonth) * 100)}%`}></div>
              </div>
              <span class="bar-label">{d.m.slice(5)}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 类型分布 -->
      <section class="panel">
        <div class="panel-head">
          <h3>内容类型</h3>
          <span>{items.length} 条</span>
        </div>
        <div class="donut-row">
          <div class="donut" style={`background: conic-gradient(${donut
            .map((d) => `${colors[d.key]} ${d.start}deg ${d.end}deg`)
            .join(', ')});`}>
            <div class="donut-hole">
              <b>{items.length}</b>
              <span>条目</span>
            </div>
          </div>
          <ul class="legend">
            {byType.map((t) => (
              <li>
                <i style={`background:${colors[t.key]}`}></i>
                <span>{t.label}</span>
                <b>{t.n}</b>
                <em>{t.pct}%</em>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 部门分布 -->
      <section class="panel">
        <div class="panel-head">
          <h3>成员部门</h3>
          <span>{members.length} 人</span>
        </div>
        <div class="hbar-list">
          {byDept.map((d) => (
            <div class="hbar-row">
              <span class="hbar-label">{d.d}</span>
              <div class="hbar-track">
                <div class="hbar" style={`width:${Math.round((d.n / maxDept) * 100)}%`}></div>
              </div>
              <span class="hbar-num">{d.n}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 内容状态 -->
      <section class="panel panel-wide">
        <div class="panel-head">
          <h3>内容状态分布</h3>
          <span>{contentStatusData.length} 种状态</span>
        </div>
        <div class="hbar-list">
          {contentStatusData.map((x) => (
            <div class="hbar-row">
              <span class="hbar-label">{x.s}</span>
              <div class="hbar-track">
                <div class="hbar hbar-neutral" style={`width:${Math.round((x.n / maxStatus) * 100)}%`}></div>
              </div>
              <span class="hbar-num">{x.n}</span>
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>
</Base>