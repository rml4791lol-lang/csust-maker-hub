---
import Base from '../layouts/Base.astro';
import { items, typeMeta } from '../data/items';
import { publishedItems } from '../data/validate';
import { members, depts } from '../data/members';
import { stats, dutyRota } from '../data/site';
import { flagEnabled } from '../data/flags';

// 看板只统计已发布内容：草稿/下架不应出现在公开数据页
const live = publishedItems(items);

// 类型分布：实际存在的类型，按数量降序；颜色取 typeMeta 单一来源
const byType = [...new Set(live.map((i) => i.type))]
  .map((t) => ({
    key: t,
    label: typeMeta[t].label,
    color: typeMeta[t].color,
    n: live.filter((i) => i.type === t).length,
  }))
  .sort((a, b) => b.n - a.n);
const maxType = Math.max(...byType.map((x) => x.n), 1);

// 月度更新
const monthMap = new Map<string, number>();
for (const i of live) {
  const m = i.date.slice(0, 7);
  monthMap.set(m, (monthMap.get(m) || 0) + 1);
}
const months = [...monthMap.keys()].sort();
const monthData = months.map((m) => ({ m, n: monthMap.get(m) || 0 }));
const maxMonth = Math.max(...monthData.map((d) => d.n), 1);

// 部门分布
const byDept = depts.map((d) => ({
  d,
  n: members.filter((m) => m.dept === d).length,
}));
const maxDept = Math.max(...byDept.map((x) => x.n), 1);

// 内容状态：从数据动态统计，不维护硬编码清单
const byStatus = Object.entries(
  live.reduce<Record<string, number>>((acc, i) => {
    acc[i.status] = (acc[i.status] || 0) + 1;
    return acc;
  }, {})
)
  .map(([s, n]) => ({ s, n }))
  .sort((a, b) => b.n - a.n);
const maxStatus = Math.max(...byStatus.map((x) => x.n), 1);

// 浏览排行面板用的条目索引（id → 标题 + 链接）
const itemIndex = Object.fromEntries(
  live.map((i) => [i.id, { t: i.title, h: i.type === 'link' && i.extra?.url ? i.extra.url : `/library/${i.id}` }])
);

// 内容值班：区间按 YYYY-MM-DD 字符串比较（字典序即时间序），条目按收录日期落入区间计数
const now = new Date();
const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

const dutyShifts = [...dutyRota]
  .sort((a, b) => a.from.localeCompare(b.from))
  .map((s) => {
    const collected = live
      .filter((i) => i.date >= s.from && i.date <= s.to)
      .map((i) => ({ id: i.id, title: i.title }));
    return {
      ...s,
      onDuty: today >= s.from && today <= s.to,
      count: collected.length,
      collected,
    };
  });

// 当前值班期；空档期（today 不落在任何区间）退回最近一期（按结束日期），并标注等待排班
const dutyNow =
  dutyShifts.find((s) => s.onDuty) ??
  [...dutyShifts].sort((a, b) => b.to.localeCompare(a.to))[0] ??
  null;
---

<Base title="数据" description="创客空间的内容、成员与浏览数据看板。">
  <div class="wrap page-header">
    <span class="crumb">DATA / 数据看板</span>
    <h1>数据看板</h1>
    <p>内容、成员与浏览量的实时聚合。所有数字从内容库自动算出来，不手工维护。</p>
  </div>

  <div class="wrap" style="padding-bottom:80px;">
    <!-- 概览 -->
    <div class="stat-cards">
      {stats.map((s) => (
        <div class="stat-card">
          <span class="stat-label">{s.k}</span>
          <span class="stat-value">{s.v}<i>{s.unit}</i></span>
        </div>
      ))}
    </div>

    <div class="chart-grid">
      <!-- 月度更新 -->
      <section class="panel">
        <div class="panel-head">
          <h2>每月新增内容</h3>
          <span>近 {monthData.length} 个月</span>
        </div>
        <div class="bar-chart">
          {monthData.map((d) => (
            <div class="bar-col">
              <span class="bar-num">{d.n}</span>
              <div class="bar-wrap">
                <div class="bar" style={`height:${Math.round((d.n / maxMonth) * 100)}%`}></div>
              </div>
              <span class="bar-label">{d.m.slice(5)}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 类型分布 -->
      <section class="panel">
        <div class="panel-head">
          <h2>内容类型</h3>
          <span>{live.length} 条</span>
        </div>
        <div class="hbar-list">
          {byType.map((t) => (
            <div class="hbar-row">
              <span class="hbar-label">{t.label}</span>
              <div class="hbar-track">
                <div class="hbar" style={`width:${Math.round((t.n / maxType) * 100)}%`}></div>
              </div>
              <span class="hbar-num">{t.n}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 部门分布 -->
      <section class="panel">
        <div class="panel-head">
          <h2>成员部门</h3>
          <span>{members.length} 人</span>
        </div>
        <div class="hbar-list">
          {byDept.map((d) => (
            <div class="hbar-row">
              <span class="hbar-label">{d.d}</span>
              <div class="hbar-track">
                <div class="hbar" style={`width:${Math.round((d.n / maxDept) * 100)}%`}></div>
              </div>
              <span class="hbar-num">{d.n}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 内容状态 -->
      <section class="panel">
        <div class="panel-head">
          <h2>内容状态分布</h3>
          <span>{byStatus.length} 种状态</span>
        </div>
        <div class="hbar-list">
          {byStatus.map((x) => (
            <div class="hbar-row">
              <span class="hbar-label">{x.s}</span>
              <div class="hbar-track">
                <div class="hbar hbar-neutral" style={`width:${Math.round((x.n / maxStatus) * 100)}%`}></div>
              </div>
              <span class="hbar-num">{x.n}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 内容值班（配置在 site.ts 的 dutyRota，空数组则不渲染；受功能开关 stats.duty 控制） -->
      {flagEnabled('stats.duty') && dutyShifts.length > 0 && dutyNow && (
        <section class="panel panel-wide">
          <div class="panel-head">
            <h2>内容值班</h3>
            <span>{dutyShifts.length} 期 · 构建时计算</span>
          </div>
          <div class="duty-now" class:list={{ 'duty-now-gap': !dutyNow.onDuty }}>
            <span class="duty-now-name">{dutyNow.name}</span>
            <span class="duty-now-range">{dutyNow.from} ~ {dutyNow.to}</span>
            <span class="duty-now-note">
              {dutyNow.onDuty ? `值班中 · 本班收录 ${dutyNow.count} 条` : '空档中，等待排班'}
            </span>
          </div>
          <div class="duty-list">
            {dutyShifts.map((s) => (
              <div class="duty-row" class:list={{ 'duty-row-current': s.onDuty }}>
                <span class="duty-name">
                  {s.name}
                  {s.onDuty && <i class="duty-flag">值班中</i>}
                </span>
                <span class="duty-date">{s.from} ~ {s.to}</span>
                <span class="duty-count">{s.count} 条</span>
                {s.collected.length > 0 && (
                  <ul class="duty-items">
                    {s.collected.slice(0, 6).map((c) => (
                      <li><a href={`/library/${c.id}`}>{c.title}</a></li>
                    ))}
                    {s.collected.length > 6 && <li class="duty-more">等 {s.collected.length} 条</li>}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 浏览量排行（实时，来自后台 metrics；受功能开关 stats.views 控制） -->
      {flagEnabled('stats.views') && (
      <section class="panel panel-wide">
        <div class="panel-head">
          <h2>浏览量排行</h3>
          <span id="viewsMeta">读取中…</span>
        </div>
        <div class="hbar-list" id="viewsBox">
          <div class="views-empty">正在从后台读取浏览数据…</div>
        </div>
      </section>
      )}

    </div>
  </div>

  <script type="application/json" id="item-index" set:html={JSON.stringify(itemIndex).replace(/</g, '\\u003c')}></script>

  <script>
    const box = document.getElementById('viewsBox');
    const meta = document.getElementById('viewsMeta');

    const esc = (s: string) =>
      String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    // 功能开关关闭时面板不渲染，box/meta 为空则整段跳过
    if (box && meta) {
      fetch('/admin/api/metrics')
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((d: any) => {
          let titles: Record<string, { t: string; h: string }> = {};
          try {
            titles = JSON.parse(document.getElementById('item-index')?.textContent || '{}');
          } catch { /* 索引缺失就用 id 兜底 */ }

          const fb = d.feedback || {};
          const fbTotal = Object.values(fb).reduce(
            (s: number, f: any) => s + (f.useful || 0) + (f.useless || 0) + (f.confirmed || 0),
            0
          );
          const fbConfirmed = Object.values(fb).reduce((s: number, f: any) => s + (f.confirmed || 0), 0);
          meta.textContent = `总浏览 ${d.total ?? 0} 次 · 反馈 ${fbTotal} 条 · 照做 ${fbConfirmed} 次`;

          const rows = (Object.entries(d.views || {}) as [string, number][]).sort((a, b) => b[1] - a[1]).slice(0, 8);
          if (!rows.length) {
            box.innerHTML = '<div class="views-empty">还没有浏览数据——有人打开攻略后，这里就会长出来。</div>';
            return;
          }
          const max = rows[0][1] || 1;
          box.innerHTML = rows
            .map(([id, n]) => {
              const t = titles[id] || { t: id, h: `/library/${id}` };
              const w = Math.max(4, Math.round((n / max) * 100));
              const conf = fb[id]?.confirmed || 0;
              // confirmed>0 时在浏览数旁带出「· K 照做」；总览行的合计见上方 viewsMeta
              const extra = conf > 0 ? `<span class="hbar-confirmed">· ${conf} 照做</span>` : '';
              return `<div class="hbar-row${extra ? ' hbar-row-extra' : ''}"><a href="${esc(t.h)}" title="${esc(t.t)}"><span class="hbar-label">${esc(t.t)}</span></a><div class="hbar-track"><div class="hbar" style="width:${w}%"></div></div><span class="hbar-num">${n}</span>${extra}</div>`;
            })
            .join('');
        })
        .catch(() => {
          meta.textContent = '实时';
          box.innerHTML = '<div class="views-empty">读不到后台服务（本地开发常见）。部署后这里会显示实时浏览数据。</div>';
        });
    }
  </script>
</Base>
