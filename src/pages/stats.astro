---
import Base from '../layouts/Base.astro';
import { items, typeMeta } from '../data/items';
import { members, depts } from '../data/members';
import { services, demands } from '../data/services';
import { stats } from '../data/site';

const types = ['project', 'competition', 'activity', 'course'] as const;

// 类型分布
const byType = types.map((t) => {
  const n = items.filter((i) => i.type === t).length;
  return { key: t, label: typeMeta[t].label, n, pct: Math.round((n / items.length) * 100) };
});

// 月度更新
const monthMap = new Map<string, number>();
for (const i of items) {
  const m = i.date.slice(0, 7);
  monthMap.set(m, (monthMap.get(m) || 0) + 1);
}
const months = [...monthMap.keys()].sort();
const monthData = months.map((m) => ({ m, n: monthMap.get(m) || 0 }));
const maxMonth = Math.max(...monthData.map((d) => d.n), 1);

// 部门分布
const byDept = depts.map((d) => ({
  d,
  n: members.filter((m) => m.dept === d).length,
}));
const maxDept = Math.max(...byDept.map((x) => x.n), 1);

// 状态分布
const statusOrder = ['已交付', '处理中', '待接'];
const byStatus = statusOrder.map((s) => ({ s, n: demands.filter((d) => d.status === s).length }));
const totalDemand = demands.length || 1;

// 内容状态
const contentStatus = ['已完成', '已上线', '已结束', '可学习', '进行中', '备赛中', '报名中'];
const contentStatusData = contentStatus
  .map((s) => ({ s, n: items.filter((i) => i.status === s).length }))
  .filter((x) => x.n > 0);
const maxStatus = Math.max(...contentStatusData.map((x) => x.n), 1);

// 计算环形图角度
let acc = 0;
const donut = byType.map((t) => {
  const start = acc;
  acc += (t.n / items.length) * 360;
  return { ...t, start, end: acc };
});
const colors: Record<string, string> = {
  project: '#b45309',
  competition: '#a16207',
  activity: '#1d4ed8',
  course: '#15803d',
};
---

<Base title="数据" description="创客空间的内容、成员、服务数据看板。">
  <div class="wrap page-header">
    <span class="crumb">DATA / 数据看板</span>
    <h1>数据看板</h1>
    <p>内容、成员、服务的实时聚合。所有数字从内容库自动算出来，不手工维护。</p>
  </div>

  <div class="wrap" style="padding-bottom:80px;">
    <!-- 概览 -->
    <div class="stat-cards">
      {stats.map((s) => (
        <div class="stat-card">
          <span class="stat-label">{s.k}</span>
          <span class="stat-value">{s.v}<i>{s.unit}</i></span>
        </div>
      ))}
    </div>

    <div class="chart-grid">
      <!-- 月度更新 -->
      <section class="panel">
        <div class="panel-head">
          <h3>每月新增内容</h3>
          <span>近 {monthData.length} 个月</span>
        </div>
        <div class="bar-chart">
          {monthData.map((d) => (
            <div class="bar-col">
              <span class="bar-num">{d.n}</span>
              <div class="bar-wrap">
                <div class="bar" style={`height:${Math.round((d.n / maxMonth) * 100)}%`}></div>
              </div>
              <span class="bar-label">{d.m.slice(5)}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 类型分布 -->
      <section class="panel">
        <div class="panel-head">
          <h3>内容类型</h3>
          <span>{items.length} 条</span>
        </div>
        <div class="donut-row">
          <div class="donut" style={`background: conic-gradient(${donut
            .map((d) => `${colors[d.key]} ${d.start}deg ${d.end}deg`)
            .join(', ')});`}>
            <div class="donut-hole">
              <b>{items.length}</b>
              <span>条目</span>
            </div>
          </div>
          <ul class="legend">
            {byType.map((t) => (
              <li>
                <i style={`background:${colors[t.key]}`}></i>
                <span>{t.label}</span>
                <b>{t.n}</b>
                <em>{t.pct}%</em>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 部门分布 -->
      <section class="panel">
        <div class="panel-head">
          <h3>成员部门</h3>
          <span>{members.length} 人</span>
        </div>
        <div class="hbar-list">
          {byDept.map((d) => (
            <div class="hbar-row">
              <span class="hbar-label">{d.d}</span>
              <div class="hbar-track">
                <div class="hbar" style={`width:${Math.round((d.n / maxDept) * 100)}%`}></div>
              </div>
              <span class="hbar-num">{d.n}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 需求状态 -->
      <section class="panel">
        <div class="panel-head">
          <h3>需求处理</h3>
          <span>共 {totalDemand} 条</span>
        </div>
        <div class="stack-bar">
          {byStatus.map((s) => (
            <div
              class="stack-seg"
              style={`flex:${s.n};background:${s.s === '已交付' ? '#16a34a' : s.s === '处理中' ? '#1a56db' : '#d6d6d6'}`}
              title={`${s.s} ${s.n}`}
            ></div>
          ))}
        </div>
        <ul class="legend legend-col">
          {byStatus.map((s) => (
            <li>
              <i style={`background:${s.s === '已交付' ? '#16a34a' : s.s === '处理中' ? '#1a56db' : '#d6d6d6'}`}></i>
              <span>{s.s}</span>
              <b>{s.n}</b>
            </li>
          ))}
        </ul>
        <div class="panel-foot">
          <a href="/services#board" class="more">查看工单 →</a>
        </div>
      </section>

      <!-- 内容状态 -->
      <section class="panel panel-wide">
        <div class="panel-head">
          <h3>内容状态分布</h3>
          <span>{contentStatusData.length} 种状态</span>
        </div>
        <div class="hbar-list">
          {contentStatusData.map((x) => (
            <div class="hbar-row">
              <span class="hbar-label">{x.s}</span>
              <div class="hbar-track">
                <div class="hbar hbar-neutral" style={`width:${Math.round((x.n / maxStatus) * 100)}%`}></div>
              </div>
              <span class="hbar-num">{x.n}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 服务 -->
      <section class="panel">
        <div class="panel-head">
          <h3>服务交付周期</h3>
          <span>{services.length} 类</span>
        </div>
        <ul class="plain-list">
          {services.map((s) => (
            <li>
              <span>{s.title}</span>
              <b>{s.sla}</b>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .stat-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }
  .stat-card {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    padding: 16px 18px;
    display: grid;
    gap: 6px;
  }
  .stat-label { font-size: 12px; color: var(--text-3); }
  .stat-value {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .stat-value i {
    font-style: normal;
    font-size: 12px;
    font-weight: 400;
    color: var(--text-3);
    margin-left: 4px;
  }

  .chart-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .panel {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    padding: 18px 20px 20px;
  }
  .panel-wide { grid-column: span 2; }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .panel-head h3 { font-size: 14.5px; font-weight: 600; margin: 0; }
  .panel-head span { font-family: var(--font-mono); font-size: 10.5px; color: var(--text-3); }
  .panel-foot { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); }

  /* 柱状图 */
  .bar-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    height: 190px;
    padding-top: 20px;
  }
  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    gap: 6px;
  }
  .bar-num { font-family: var(--font-mono); font-size: 11px; color: var(--text-3); }
  .bar-wrap {
    flex: 1;
    width: 100%;
    max-width: 46px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .bar {
    width: 100%;
    background: var(--text);
    border-radius: 4px 4px 2px 2px;
    transform-origin: bottom;
    animation: grow 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    min-height: 4px;
  }
  .bar-col:nth-child(2) .bar { animation-delay: 0.05s; }
  .bar-col:nth-child(3) .bar { animation-delay: 0.1s; }
  .bar-col:nth-child(4) .bar { animation-delay: 0.15s; }
  .bar-col:nth-child(5) .bar { animation-delay: 0.2s; }
  @keyframes grow { from { transform: scaleY(0); } }
  .bar-label { font-family: var(--font-mono); font-size: 10.5px; color: var(--text-3); }

  /* 环形图 */
  .donut-row { display: flex; align-items: center; gap: 26px; padding: 6px 0 10px; }
  .donut {
    width: 132px;
    height: 132px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    position: relative;
  }
  .donut-hole {
    width: 86px;
    height: 86px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1px;
  }
  .donut-hole b { font-size: 22px; font-weight: 700; line-height: 1; }
  .donut-hole span { font-size: 10.5px; color: var(--text-3); }
  .legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; flex: 1; }
  .legend li {
    display: grid;
    grid-template-columns: 8px 1fr auto auto;
    gap: 8px;
    align-items: center;
    font-size: 12.5px;
  }
  .legend i { width: 8px; height: 8px; border-radius: 2px; }
  .legend span { color: var(--text-2); }
  .legend b { font-weight: 500; }
  .legend em { font-style: normal; font-family: var(--font-mono); font-size: 10.5px; color: var(--text-3); }
  .legend-col { margin-top: 14px; }
  .legend-col li { grid-template-columns: 8px 1fr auto; }

  /* 横向条 */
  .hbar-list { display: grid; gap: 12px; }
  .hbar-row {
    display: grid;
    grid-template-columns: 88px 1fr 28px;
    gap: 12px;
    align-items: center;
  }
  .hbar-label { font-size: 12.5px; color: var(--text-2); }
  .hbar-track { height: 8px; background: var(--bg-sub); border-radius: 4px; overflow: hidden; }
  .hbar {
    height: 100%;
    background: var(--text);
    border-radius: 4px;
    animation: slide 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    transform-origin: left;
  }
  .hbar-neutral { background: #9a9a9a; }
  @keyframes slide { from { transform: scaleX(0); } }
  .hbar-num {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-2);
    text-align: right;
  }

  /* 堆叠条 */
  .stack-bar {
    display: flex;
    height: 10px;
    border-radius: 5px;
    overflow: hidden;
    background: var(--bg-sub);
    gap: 2px;
  }
  .stack-seg { height: 100%; min-width: 2px; }

  /* 明细列表 */
  .plain-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .plain-list li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 12.5px;
  }
  .plain-list li:last-child { border-bottom: 0; }
  .plain-list span { color: var(--text-2); }
  .plain-list b { font-weight: 400; font-family: var(--font-mono); font-size: 11.5px; color: var(--text-3); white-space: nowrap; }

  @media (max-width: 980px) {
    .stat-cards { grid-template-columns: repeat(2, 1fr); }
    .chart-grid { grid-template-columns: 1fr; }
    .panel-wide { grid-column: span 1; }
  }
  @media (max-width: 680px) {
    .donut-row { flex-direction: column; align-items: flex-start; }
    .bar-chart { height: 150px; }
  }
</style>
