---
import Base from '../layouts/Base.astro';
import { site, stats } from '../data/site';
import { depts } from '../data/members';

const deptDesc: Record<string, string> = {
  技术部: '课程、项目、技术支持和网站维护。把 AI 和工作流做成能复用的东西。',
  竞赛部: '国赛省赛的报名、组队、技术支撑和答辩材料。',
  宣传部: '视觉、推文、视频和活动记录。',
  创新创业部: '项目孵化、软著专利材料和商业机会对接。',
};
---

<Base title="关于" description={site.description}>
  <div class="wrap page-header">
    <span class="crumb">ABOUT / 关于</span>
    <h1>关于我们</h1>
    <p>{site.description}</p>
  </div>

  <section class="section" style="padding-top:8px;">
    <div class="wrap">
      <div class="about-grid">
        <div>
          <span class="index">01 / WHAT</span>
          <h2 class="section-title" style="margin:12px 0 20px;">我们在做的四件事</h2>
          <div class="about-list">
            {[
              ['技术指导课程', '把 AI 和工程技能拆成能上手的课，教完留资料。'],
              ['竞赛 + AI', '服务国赛省赛：组队、技术方案、演示和答辩材料。'],
              ['软著 / 专利材料', '把落地的项目整理成可提交的申请材料。'],
              ['低风险商业试点', '先在校内跑通，再看能不能对外。'],
            ].map(([t, d], i) => (
              <div class="about-row">
                <span class="n">0{i + 1}</span>
                <div><h4>{t}</h4><p>{d}</p></div>
              </div>
            ))}
          </div>
        </div>

        <aside>
          <div class="side-box">
            <h5>数字</h5>
            <dl class="meta-list">
              {stats.map((s) => (
                <div><dt>{s.k}</dt><dd>{s.v} {s.unit}</dd></div>
              ))}
            </dl>
          </div>
          <div class="side-box" style="margin-top:14px;">
            <h5>联系</h5>
            <dl class="meta-list">
              <div><dt>邮箱</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>
              <div><dt>归属</dt><dd>{site.contact.group}</dd></div>
              <div><dt>地址</dt><dd>{site.contact.address}</dd></div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--line);">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="index">02 / TEAM</span>
          <h2 class="section-title">部门</h2>
          <p class="section-desc">四个部门，各管一段，需求统一走服务台。</p>
        </div>
      </div>
      <div class="dept-grid">
        {depts.map((d, i) => (
          <div class="dept-card">
            <span class="sc-idx">0{i + 1}</span>
            <h3>{d}</h3>
            <p>{deptDesc[d]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--line);padding-bottom:120px;">
    <div class="wrap">
      <div style="max-width:720px;">
        <span class="index">03 / JOIN</span>
        <h2 class="section-title" style="font-size:clamp(28px,4vw,46px);margin:14px 0 18px;">
          想一起做点东西，或者有个活需要我们帮。
        </h2>
        <p class="section-desc" style="margin-bottom:28px;">两种都欢迎。提需求走服务台，想说别的直接发邮件。</p>
        <div class="hero-actions">
          <a href="/services" class="btn btn-primary">提一个需求 <span class="arrow">→</span></a>
          <a href={`mailto:${site.contact.email}`} class="btn btn-ghost">发邮件 <span class="arrow">↗</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>
