---
import Base from '../../layouts/Base.astro';
import { members } from '../../data/members';
import { profileByMember, submissionsByMember, contributionTypeLabel, type Submission } from '../../data/contributions';
import { items, typeMeta } from '../../data/items';
import { publishedItems } from '../../data/validate';

export function getStaticPaths() {
  return members.map((m) => ({ params: { id: m.id }, props: { member: m } }));
}

const { member } = Astro.props;
const profile = profileByMember(member.id);
const timeline = submissionsByMember(member.id);
const live = publishedItems(items);
const involved = live.filter((i) => (i.people ?? []).includes(member.name)).sort((a, b) => (a.date < b.date ? 1 : -1));
const stats = profile?.stats;

const href = (s: Submission) => (s.link && /^https?:\/\//.test(s.link) ? s.link : s.link ?? '');
const external = (s: Submission) => Boolean(s.link && /^https?:\/\//.test(s.link));
const typeOf = (t: string) => contributionTypeLabel[t as keyof typeof contributionTypeLabel] ?? t;
---

<Base title={`${member.name} · 成员档案`} description={profile?.aiSummary ?? `${member.name}的成果档案`} noindex>
  <div class="wrap page-header">
    <a href="/members" class="crumb" style="display:block;width:fit-content;margin-bottom:16px;">← 返回成员</a>
    <span class="crumb">MEMBER / 成员档案</span>
    <h1>{member.name}的成果档案</h1>
    <p>成员自己提交 + AI 汇总的成长记录：做过什么、擅长什么、下一步可以做什么。</p>
  </div>

  <div class="wrap" style="padding-bottom:96px;">
    <div class="profile-hero">
      <div class="profile-card" data-reveal>
        <div class="profile-avatar">{member.name.slice(0, 1)}</div>
        <h2 class="profile-name">
          {member.name}
          {member.role ? <span class="profile-role">{member.role}</span> : null}
        </h2>
        <div class="profile-meta">{member.dept} · {member.grade}{member.bio ? ` · ${member.bio}` : ''}</div>
        <div class="profile-skills">
          {member.skills.map((s) => <span class="tag">{s}</span>)}
        </div>
        <div class="profile-stats">
          <div class="profile-stat"><b>{stats?.contributions ?? timeline.length}</b><span>成果记录</span></div>
          <div class="profile-stat"><b>{involved.length}</b><span>参与内容</span></div>
          <div class="profile-stat"><b>{involved.filter((i) => i.type === 'guide').length}</b><span>攻略贡献</span></div>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:20px;">
          <a href="/contribute" class="btn btn-primary btn-sm">提交我的成果 <span class="ar">→</span></a>
          <a href="/members" class="btn btn-ghost btn-sm">全部成员</a>
        </div>
      </div>

      <aside class="ai-panel" data-reveal data-delay="90">
        <span class="ai-tag">✦ AI 汇总{profile?.aiUpdatedAt ? ` · ${profile.aiUpdatedAt}` : ''}</span>
        <p class="ai-summary">{profile?.aiSummary ?? '这个成员的档案还在整理中。'}</p>

        {profile?.focusTags?.length ? (
          <>
            <div class="ai-sub">关注方向</div>
            <div class="profile-skills" style="margin-top:8px;">
              {profile.focusTags.map((t) => <span class="skill-chip">{t}</span>)}
            </div>
          </>
        ) : null}

        {profile?.highlights?.length ? (
          <>
            <div class="ai-sub">代表成果</div>
            <ul class="ai-list">
              {profile.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </>
        ) : null}

        {profile?.nextStep ? (
          <div class="ai-next"><b>下一步建议：</b>{profile.nextStep}</div>
        ) : null}
      </aside>
    </div>

    <!-- ================= 成果记录 ================= -->
    <section class="section" style="padding-top:72px;">
      <div class="section-head" data-reveal>
        <div>
          <div class="sec-index"><b>01</b><span class="rule"></span>成果记录</div>
          <h2 class="sec-title">做过的项目、比赛和分享。</h2>
          <p class="sec-desc">按时间倒序。来自本人提交或内容库回填，审核后展示。</p>
        </div>
        <a class="sec-more" href="/contribute">提交我的成果 <span class="ar">→</span></a>
      </div>

      <div class="list-panel" data-reveal>
        <div class="list-head">
          <span class="dot-live"></span>
          <span>ACHIEVEMENTS / 成果记录</span>
          <span style="margin-left:auto">{timeline.length} 条</span>
        </div>
        {timeline.length ? (
          <div class="timeline" style="padding:6px 18px 12px;">
            {timeline.map((s) => (
              <div class="tl-item">
                <span class="tl-date">{s.date.replaceAll('-', '.')}</span>
                <div class="tl-body">
                  <b>{s.title}</b>
                  <span class="tl-type">{typeOf(s.type)}</span>
                  <p class="tl-desc">{s.description}</p>
                  {s.image ? <img class="tl-img" src={s.image} alt={`${s.title} 配图`} loading="lazy" /> : null}
                  {s.outcome ? <div class="tl-outcome">产出：{s.outcome}</div> : null}
                  {s.link ? (
                    <a class="tl-link" href={href(s)} target={external(s) ? '_blank' : undefined} rel={external(s) ? 'noopener' : undefined}>
                      查看相关 {external(s) ? '↗' : '→'}
                    </a>
                  ) : null}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="views-empty" style="padding:28px 18px;">还没有成果记录。点右上角「提交我的成果」，第一条就从你开始。</div>
        )}
      </div>
    </section>

    <!-- ================= 参与内容 ================= -->
    <section class="section" style="padding-top:64px;">
      <div class="section-head" data-reveal>
        <div>
          <div class="sec-index"><b>02</b><span class="rule"></span>参与内容</div>
          <h2 class="sec-title">在内容库里留下的东西。</h2>
          <p class="sec-desc">攻略、技能指令、模板、项目、竞赛、活动与课程，按收录日期倒序。</p>
        </div>
        <a class="sec-more" href="/library">全部内容 <span class="ar">→</span></a>
      </div>

      <div class="data-list" data-reveal>
        {involved.length ? involved.map((i) => (
          <a class="data-row" href={`/library/${i.id}`}>
            <span class="data-type" data-type={i.type}><i>{typeMeta[i.type].glyph}</i>{typeMeta[i.type].label}</span>
            <span class="data-main">
              <b>{i.title}</b>
              <i>{i.summary}</i>
            </span>
            <span class="data-people">{i.people.join(' / ')}</span>
            <span class="data-status" data-s={i.status}>{i.status}</span>
            <span class="data-date">{i.date.replaceAll('-', '.')}</span>
          </a>
        )) : (
          <div class="views-empty" style="padding:28px 18px;">内容库里暂时没有关联记录。</div>
        )}
      </div>
    </section>
  </div>
</Base>
