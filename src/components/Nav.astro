---
import { site } from '../data/site';
import { flagEnabled } from '../data/flags';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
// 功能开关：tools 关闭时导航不出现该入口
const navItems = site.nav.filter((n) => flagEnabled('tools') || n.href !== '/tools');
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label={site.name}>
      <span class="brand-mark">创</span>
      <span>{site.name}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {navItems.map((n) => (
        <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div style="display:flex;align-items:center;gap:10px;">
      <button class="nav-search" data-cmdk-open aria-label="搜索站内内容">
        <span>⌕</span><span class="nav-search-text">搜索</span><kbd>⌘K</kbd>
      </button>
      <button class="nav-burger" aria-label="菜单" aria-expanded="false">≡</button>
    </div>
  </div>
</header>
