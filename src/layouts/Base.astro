---
import { site } from '../data/site';
import { items, typeMeta } from '../data/items';
import { publishedItems } from '../data/validate';
import { members } from '../data/members';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline.join('')}`;
const desc = description ?? site.description;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const navItems = site.nav;

/** 站内搜索索引：只索引已发布内容，草稿/下架不能出现在公开页面里 */
const searchIndex = [
  ...publishedItems(items).map((i) => ({
    t: '内容',
    k: typeMeta[i.type].label,
    title: i.title,
    desc: i.summary,
    url: `/library/${i.id}`,
    q: [i.title, i.summary, ...i.tags, ...i.people].join(' '),
  })),
  ...members.map((m) => ({
    t: '成员',
    k: m.dept,
    title: m.name + (m.role ? ` · ${m.role}` : ''),
    desc: `${m.grade} · ${m.skills.join(' / ')}`,
    url: `/members#${m.id}`,
    q: [m.name, m.dept, m.grade, ...m.skills, m.bio ?? ''].join(' '),
  })),
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#08090a" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%2308090a'/%3E%3Cpath d='M9 22V10h3l8 8.2V10h3v12h-3l-8-8.2V22z' fill='%238fa4ff'/%3E%3C/svg%3E" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="tech">
    <div class="page-glow" aria-hidden="true">
      <div class="grid"></div>
      <div class="aurora"></div>
    </div>

    <header class="tnav">
      <div class="wrap tnav-inner">
        <a href="/" class="brand" aria-label={site.name}>
          <span class="brand-mark">创</span>
          <span>{site.name}</span>
          <span class="brand-sub">MAKER SPACE</span>
        </a>

        <nav class="tlinks" aria-label="主导航">
          {navItems.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>

        <div class="tright">
          <button class="nav-search" data-cmdk-open aria-label="搜索站内内容">
            <span>⌕</span><span>搜索</span><kbd>⌘K</kbd>
          </button>
          <span class="status-pill"><i></i>内部知识库 · 在线</span>
          <a class="btn btn-primary btn-sm" href="/library">进入内容库 <span class="ar">→</span></a>
          <button class="tburger" aria-label="菜单" aria-expanded="false">≡</button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="tfoot">
      <div class="wrap">
        <div class="tfoot-grid">
          <div class="tfoot-brand">
            <a href="/" class="brand"><span class="brand-mark">创</span><span>{site.name}</span></a>
            <p>{site.description}</p>
          </div>
          <div>
            <h5>站内</h5>
            <ul>
              {navItems.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h5>联系</h5>
            <ul>
              <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
              <li><span>{site.contact.group}</span></li>
              <li><span>{site.contact.address}</span></li>
            </ul>
          </div>
        </div>
        <div class="tfoot-bottom">
          <span>© {new Date().getFullYear()} {site.name} · {site.nameEn}</span>
          <span>MAKE SOMETHING REAL.</span>
        </div>
      </div>
    </footer>

    <script type="application/json" id="site-index" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')}></script>

    <div class="cmdk" id="cmdk" aria-hidden="true">
      <div class="cmdk-bg" data-cmdk-close></div>
      <div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
        <div class="cmdk-top">
          <span class="cmdk-icon">⌕</span>
          <input id="cmdkInput" type="text" placeholder="搜索内容、成员…" autocomplete="off" spellcheck="false" />
          <kbd>ESC</kbd>
        </div>
        <div class="cmdk-body" id="cmdkBody">
          <div class="cmdk-hint" id="cmdkHint">
            <span>输入关键词开始搜索</span>
            <span class="cmdk-hint-sub">或者在任意页面按 <kbd>⌘</kbd><kbd>K</kbd></span>
          </div>
        </div>
        <div class="cmdk-foot">
          <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
          <span><kbd>↵</kbd> 打开</span>
          <span><kbd>esc</kbd> 关闭</span>
        </div>
      </div>
    </div>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---------- 滚动入场：默认可见，JS 才做渐进 ----------
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              const delay = Number(el.dataset.delay || 0);
              el.style.setProperty('--d', `${delay}ms`);
              el.classList.add('in');
              io.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('in'));
      }

      // ---------- 数字滚动 ----------
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const animateCount = (el: HTMLElement) => {
        const target = Number(el.dataset.count || 0);
        if (reduce || !target) {
          el.textContent = String(target);
          return;
        }
        el.textContent = '0';
        const dur = 1200;
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 4);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      if ('IntersectionObserver' in window) {
        const cio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              animateCount(e.target as HTMLElement);
              cio.unobserve(e.target);
            }
          },
          { threshold: 0.5 }
        );
        counters.forEach((el) => cio.observe(el));
      } else {
        counters.forEach(animateCount);
      }

      // ---------- Hero 光斑跟随 + 控制台倾斜 ----------
      const hero = document.querySelector<HTMLElement>('.hero');
      const consoleEl = document.querySelector<HTMLElement>('.console');
      if (hero && consoleEl && !reduce) {
        let raf = 0;
        hero.addEventListener('pointermove', (ev) => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            const r = hero.getBoundingClientRect();
            const x = ((ev.clientX - r.left) / r.width) * 100;
            const y = ((ev.clientY - r.top) / r.height) * 100;
            hero.style.setProperty('--hx', `${x}%`);
            hero.style.setProperty('--hy', `${y}%`);
            consoleEl.style.setProperty('--tx', `${(-(y - 50) / 50 * 3).toFixed(2)}deg`);
            consoleEl.style.setProperty('--ty', `${((x - 50) / 50 * 4).toFixed(2)}deg`);
          });
        });
        hero.addEventListener('pointerleave', () => {
          consoleEl.style.setProperty('--tx', '0deg');
          consoleEl.style.setProperty('--ty', '0deg');
        });
      }

      // ---------- 卡片跟随鼠标的柔光 ----------
      document.querySelectorAll<HTMLElement>('.entry-card, .self-card, .dept-card').forEach((card) => {
        card.addEventListener('pointermove', (ev) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${((ev.clientX - r.left) / r.width) * 100}%`);
          card.style.setProperty('--my', `${((ev.clientY - r.top) / r.height) * 100}%`);
        });
      });

      // ---------- 移动端菜单 ----------
      const burger = document.querySelector<HTMLButtonElement>('.tburger');
      const links = document.querySelector<HTMLElement>('.tlinks');
      burger?.addEventListener('click', () => {
        links?.classList.toggle('open');
        burger.setAttribute('aria-expanded', String(links?.classList.contains('open')));
      });

      // ---------- 站内搜索（⌘K） ----------
      const cmdkEl = document.getElementById('cmdk');
      const cmdkInput = document.getElementById('cmdkInput') as HTMLInputElement | null;
      const cmdkBody = document.getElementById('cmdkBody');
      const indexEl = document.getElementById('site-index');
      let idx: any[] = [];
      try {
        idx = JSON.parse(indexEl?.textContent || '[]');
      } catch {
        idx = [];
      }
      let filtered: any[] = [];
      let cursor = 0;

      const esc = (s: string) =>
        String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

      function paint() {
        cmdkBody?.querySelectorAll<HTMLElement>('.cmdk-item').forEach((el) => {
          el.classList.toggle('active', Number(el.dataset.i) === cursor);
        });
        cmdkBody?.querySelector<HTMLElement>('.cmdk-item.active')?.scrollIntoView({ block: 'nearest' });
      }

      function render(q: string) {
        const kw = q.trim().toLowerCase();
        filtered = !kw
          ? idx.slice(0, 8)
          : idx.filter((r) => String(r.q || '').toLowerCase().includes(kw)).slice(0, 12);
        cursor = 0;
        if (!cmdkBody) return;
        if (!filtered.length) {
          cmdkBody.innerHTML = '<div class="cmdk-hint"><span>没有匹配的结果</span></div>';
          return;
        }
        let html = '';
        let lastT = '';
        filtered.forEach((r, i) => {
          if (r.t !== lastT) {
            html += `<div class="cmdk-group">${esc(r.t)}</div>`;
            lastT = r.t;
          }
          html += `<a class="cmdk-item${i === 0 ? ' active' : ''}" href="${esc(r.url)}" data-i="${i}">
            <span class="cmdk-kind">${esc(r.k)}</span>
            <span class="cmdk-main"><b>${esc(r.title)}</b><i>${esc(r.desc)}</i></span>
            <span class="cmdk-go">↵</span>
          </a>`;
        });
        cmdkBody.innerHTML = html;
        cmdkBody.querySelectorAll<HTMLElement>('.cmdk-item').forEach((el) => {
          el.addEventListener('mouseenter', () => {
            cursor = Number(el.dataset.i || 0);
            paint();
          });
        });
      }

      const openCmdk = () => {
        cmdkEl?.classList.add('open');
        cmdkEl?.setAttribute('aria-hidden', 'false');
        if (cmdkInput) {
          cmdkInput.value = '';
          cmdkInput.focus();
        }
        render('');
      };
      const closeCmdk = () => {
        cmdkEl?.classList.remove('open');
        cmdkEl?.setAttribute('aria-hidden', 'true');
      };

      document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.addEventListener('click', openCmdk));
      document.querySelectorAll('[data-cmdk-close]').forEach((b) => b.addEventListener('click', closeCmdk));
      cmdkInput?.addEventListener('input', () => render(cmdkInput.value));
      cmdkInput?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          cursor = Math.min(cursor + 1, filtered.length - 1);
          paint();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          cursor = Math.max(cursor - 1, 0);
          paint();
        } else if (e.key === 'Enter') {
          const r = filtered[cursor];
          if (r) location.href = r.url;
        }
      });
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (cmdkEl?.classList.contains('open')) closeCmdk();
          else openCmdk();
        }
        if (e.key === 'Escape' && cmdkEl?.classList.contains('open')) closeCmdk();
      });
    </script>
  </body>
</html>
